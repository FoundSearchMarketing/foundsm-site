---
/*
  The dark "AI, inside the Loop" band from the homepage, as a block any page
  can place: eyebrow and heading on the left, intro on the right, three
  columns beneath. Needs `bodyClass="site-2026"` on the page for the type
  system and tokens.
*/
export type AiLoopColumn = { title: string; body: string };

interface Props {
  id?: string;
  eyebrow: string;
  heading: string;
  intro: string;
  columns: AiLoopColumn[];
}

const { id = 'ai', eyebrow, heading, intro, columns } = Astro.props;
const titleId = `${id}-title`;
---

<section class="ai-band" id={id} aria-labelledby={titleId}>
  <div class="ai-band__inner">
    <div class="ai-band__head">
      <div class="ai-band__title">
        <p class="eyebrow-2026">{eyebrow}</p>
        <h2 id={titleId}>{heading}</h2>
      </div>
      <p class="ai-band__intro">{intro}</p>
    </div>
    <div class="ai-band__columns">
      {columns.map((column) => (
        <div class="ai-band__col">
          <h3>{column.title}</h3>
          <p>{column.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ai-band {
    padding-block: var(--s26-section);
    background: var(--s26-ink);
    color: #fff;
  }

  .ai-band__inner {
    display: grid;
    gap: 2.75rem;
    width: var(--s26-shell);
    margin-inline: auto;
  }

  .ai-band__head {
    display: grid;
    align-items: end;
    gap: 1.5rem 4rem;
  }

  .ai-band__title {
    display: grid;
    gap: 0.875rem;
    max-width: 45rem;
  }

  .ai-band h2 {
    margin: 0;
    color: inherit;
    font-size: var(--s26-size-h2);
    line-height: 1.05;
  }

  .ai-band__intro {
    margin: 0;
    max-width: 29rem;
    color: var(--s26-light);
    font-size: var(--s26-text-body);
    line-height: var(--s26-lh-body);
  }

  .ai-band__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .ai-band__col {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1.375rem;
    border-top: 1px solid var(--s26-dark-line);
  }

  .ai-band h3 {
    margin: 0;
    color: inherit;
    font-size: var(--s26-size-h3);
    line-height: 1.1;
  }

  .ai-band__col p {
    margin: 0;
    color: var(--s26-light);
    font-size: var(--s26-text-small);
    line-height: var(--s26-lh-small);
  }

  @media (min-width: 900px) {
    .ai-band__head {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }

    .ai-band__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

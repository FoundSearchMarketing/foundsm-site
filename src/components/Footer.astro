---
/*
  Site footer (October 2026): wordmark and address, four link columns that
  mirror the primary navigation, and a legal row. The newsletter embed and
  the contact teaser that used to live here are now carried by the homepage
  (The Found Brief subscribe, Talk with us form) and the newsletter page.
*/
import { enableThirdPartyScripts } from '../lib/thirdPartyScripts';

type FooterLink = { label: string; href: string };
type FooterColumn = { id: string; title: string; links: FooterLink[] };

const columns: FooterColumn[] = [
  {
    id: 'expertise',
    title: 'Expertise',
    links: [
      { label: 'The Found Loop', href: '/our-approach/' },
      { label: 'The Found Deployment', href: '/#engage' },
      { label: 'Practices', href: '/capabilities/' },
    ],
  },
  {
    id: 'work',
    title: 'Work',
    links: [
      { label: 'Results', href: '/results/' },
      { label: 'Case stories', href: '/#work' },
      { label: 'By industry', href: '/industry/' },
    ],
  },
  {
    id: 'research',
    title: 'Research',
    links: [
      { label: 'The Found Brief', href: '/newsletter/' },
      { label: 'Found Signals', href: '/insights/' },
      { label: 'Insights', href: '/insights/' },
      { label: 'Events', href: '/events/' },
    ],
  },
  {
    id: 'company',
    title: 'Company',
    links: [
      { label: 'About', href: '/about-us/' },
      { label: 'Team', href: '/team/' },
      { label: 'Life at Found', href: '/life-at-found/' },
      { label: 'Career opportunities', href: '/about-us/#careers' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-footer__wordmark" href="/" aria-label="FoundSM home">Found<span>SM</span></a>
      <address class="site-footer__address">
        8475 Nightfall Lane, Suite 200<br>
        Fishers, IN 46037<br>
        <a href="mailto:info@foundsm.com">info@foundsm.com</a><br>
        <a href="tel:+13177212229">1.317.721.2229</a>
      </address>
    </div>

    {columns.map((column) => (
      <nav class="site-footer__column" aria-labelledby={`footer-${column.id}-title`}>
        <h2 class="site-footer__title" id={`footer-${column.id}-title`}>{column.title}</h2>
        <ul class="site-footer__links" role="list">
          {column.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="site-footer__inner site-footer__lower">
    <p class="site-footer__copyright">&copy; 2006&ndash;2026, Found Search Marketing. All rights reserved.</p>
    <ul class="site-footer__legal" role="list" aria-label="Legal">
      <li><a href="/privacy-policy/">Privacy Policy</a></li>
      {enableThirdPartyScripts && (
        <li>
          <button class="site-footer__cookie" data-cookie-settings-trigger type="button">Cookie Settings</button>
        </li>
      )}
    </ul>
  </div>
</footer>

<script is:inline>
  (function() {
    // HubSpot forms loader kept for pages still carrying legacy hs-form-frame
    // embeds (InsightResourcePage, SplitFeature, FormLanding) — remove once
    // those migrate.
    var embedSrc = 'https://js.hsforms.net/forms/embed/5045186.js';
    if (!document.querySelector('script[src="' + embedSrc + '"]')) {
      var script = document.createElement('script');
      script.src = embedSrc;
      script.defer = true;
      document.body.appendChild(script);
    }
  })();
</script>

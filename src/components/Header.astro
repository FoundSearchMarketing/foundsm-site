---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isExactPath = (href: string) => currentPath === (href.replace(/\/$/, '') || '/');
const isPathSection = (href: string) => {
  const normalizedHref = href.replace(/\/$/, '') || '/';
  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Found Search Marketing home">
      <img
        class="site-header__logo"
        src="/images/logo.svg"
        alt="Found Search Marketing"
        width="209"
        height="43"
        loading="eager"
      />
    </a>

    <nav
      class="site-header__nav"
      id="primary-navigation"
      aria-label="Primary"
      aria-hidden="true"
    >
      <ul class="site-header__menu" role="list">
        <li class="site-header__item">
          <a class="site-header__link" href="/our-approach/" aria-current={isExactPath('/our-approach/') ? 'page' : undefined}>Our Approach</a>
        </li>
        <li class="site-header__item">
          <a class="site-header__link" href="/insights/" aria-current={isPathSection('/insights/') ? 'page' : undefined}>Insights</a>
        </li>
        <li class="site-header__item site-header__item--has-submenu">
          <a class="site-header__link" href="/capabilities/" aria-current={isExactPath('/capabilities/') ? 'page' : undefined}>Capabilities</a>
          <button
            class="site-header__submenu-toggle"
            type="button"
            aria-label="Toggle Capabilities submenu"
            aria-expanded="false"
            aria-controls="submenu-capabilities"
          >
            <span class="site-header__sr-only">Toggle Capabilities submenu</span>
          </button>
          <ul
            class="site-header__submenu"
            id="submenu-capabilities"
            role="list"
            aria-hidden="true"
          >
            <li><a class="site-header__submenu-link" href="/capabilities/paid-media/" aria-current={isExactPath('/capabilities/paid-media/') ? 'page' : undefined}>Paid Media</a></li>
            <li><a class="site-header__submenu-link" href="/capabilities/data-activation/" aria-current={isExactPath('/capabilities/data-activation/') ? 'page' : undefined}>Data Activation</a></li>
            <li><a class="site-header__submenu-link" href="/capabilities/data-intelligence/" aria-current={isExactPath('/capabilities/data-intelligence/') ? 'page' : undefined}>Data Intelligence</a></li>
            <li><a class="site-header__submenu-link" href="/capabilities/performance-creative/" aria-current={isExactPath('/capabilities/performance-creative/') ? 'page' : undefined}>Performance Creative</a></li>
          </ul>
        </li>
        <li class="site-header__item site-header__item--has-submenu">
          <a class="site-header__link" href="/resources/tools/" aria-current={isPathSection('/resources/') ? 'page' : undefined}>Resources</a>
          <button
            class="site-header__submenu-toggle"
            type="button"
            aria-label="Toggle Resources submenu"
            aria-expanded="false"
            aria-controls="submenu-resources"
          >
            <span class="site-header__sr-only">Toggle Resources submenu</span>
          </button>
          <ul
            class="site-header__submenu"
            id="submenu-resources"
            role="list"
            aria-hidden="true"
          >
            <li><a class="site-header__submenu-link" href="/resources/tools/" aria-current={isExactPath('/resources/tools/') ? 'page' : undefined}>Tools &amp; Custom Builds</a></li>
            <li><a class="site-header__submenu-link" href="/whitepapers/first-party-data/" aria-current={isPathSection('/whitepapers/') ? 'page' : undefined}>Whitepapers</a></li>
            <li><a class="site-header__submenu-link" href="/events/" aria-current={isPathSection('/events/') ? 'page' : undefined}>Events</a></li>
          </ul>
        </li>
        <li class="site-header__item site-header__item--has-submenu">
          <a class="site-header__link" href="/about-us/" aria-current={isExactPath('/about-us/') ? 'page' : undefined}>About Us</a>
          <button
            class="site-header__submenu-toggle"
            type="button"
            aria-label="Toggle About Us submenu"
            aria-expanded="false"
            aria-controls="submenu-about"
          >
            <span class="site-header__sr-only">Toggle About Us submenu</span>
          </button>
          <ul
            class="site-header__submenu"
            id="submenu-about"
            role="list"
            aria-hidden="true"
          >
            <li><a class="site-header__submenu-link" href="/newsletter/">Newsletter</a></li>
            <li><a class="site-header__submenu-link" href="/team/">Team</a></li>
          </ul>
        </li>
        <li class="site-header__item site-header__item--cta">
          <a class="site-header__link site-header__cta site-header__cta--primary" href="/contact-us/">Contact Us</a>
        </li>
        <li class="site-header__item site-header__item--cta">
          <a class="site-header__link site-header__cta site-header__cta--secondary" href="/about-us/#careers">Join Us</a>
        </li>
      </ul>
    </nav>

    <button
      class="site-header__menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-controls="primary-navigation"
      aria-expanded="false"
    >
      <svg class="site-header__menu-icon site-header__menu-icon--open" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
      </svg>
      <svg class="site-header__menu-icon site-header__menu-icon--close" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
      </svg>
      <span class="site-header__sr-only">Toggle navigation menu</span>
    </button>
  </div>

  <div class="site-header__scrim" aria-hidden="true"></div>
</header>

<script>
  (() => {
    const header = document.querySelector<HTMLElement>(".site-header");
    const nav = document.querySelector<HTMLElement>(".site-header__nav");
    const menuToggle = document.querySelector<HTMLButtonElement>(".site-header__menu-toggle");
    const scrim = document.querySelector<HTMLElement>(".site-header__scrim");
    const submenuItems = Array.from(
      document.querySelectorAll<HTMLElement>(".site-header__item--has-submenu")
    );
    const mobileQuery = window.matchMedia("(max-width: 1024px)");

    if (!header || !nav || !menuToggle) {
      return;
    }

    /* The drawer and scrim are fixed to the viewport, so they need the real
       header height. The --header-height token reads 85px below 1025px while
       the header actually renders at 66px, so publish the measured value. */
    const publishHeaderHeight = () => {
      const { height } = header.getBoundingClientRect();
      if (height > 0) {
        header.style.setProperty("--header-h", `${Math.round(height)}px`);
      }
    };

    const isFocusable = (el: HTMLElement) =>
      el.getClientRects().length > 0 && getComputedStyle(el).visibility !== "hidden";

    const drawerFocusables = () =>
      [
        menuToggle,
        ...Array.from(nav.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")),
      ].filter(isFocusable);

    const setSubmenuOpen = (item: HTMLElement, open: boolean) => {
      const toggle = item.querySelector<HTMLButtonElement>(".site-header__submenu-toggle");
      const submenu = item.querySelector<HTMLElement>(".site-header__submenu");
      if (!toggle || !submenu) return;

      item.classList.toggle("is-submenu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      submenu.setAttribute("aria-hidden", String(!open));
    };

    const closeAllSubmenus = (except: HTMLElement | null = null) => {
      submenuItems.forEach((item) => {
        if (item !== except) {
          setSubmenuOpen(item, false);
        }
      });
    };

    const setMenuOpen = (open: boolean) => {
      const isMobile = mobileQuery.matches;

      if (open && isMobile) {
        publishHeaderHeight();
      }

      header.classList.toggle("is-menu-open", open);
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu"
      );
      nav.setAttribute("aria-hidden", isMobile ? String(!open) : "false");
      document.documentElement.classList.toggle("has-menu-open", isMobile && open);

      if (!open) {
        closeAllSubmenus();
        return;
      }

      /* Move focus into the drawer so keyboard and screen reader users are not
         left behind the scrim. Waits a frame for visibility to flip. */
      if (isMobile) {
        window.requestAnimationFrame(() => {
          const first = nav.querySelector<HTMLElement>("a[href], button:not([disabled])");
          if (first && isFocusable(first)) {
            first.focus();
          }
        });
      }
    };

    const syncViewportState = () => {
      publishHeaderHeight();

      if (mobileQuery.matches) {
        const open = header.classList.contains("is-menu-open");
        nav.setAttribute("aria-hidden", String(!open));
        document.documentElement.classList.toggle("has-menu-open", open);
      } else {
        header.classList.remove("is-menu-open");
        document.documentElement.classList.remove("has-menu-open");
        nav.setAttribute("aria-hidden", "false");
        closeAllSubmenus();
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open navigation menu");
      }
    };

    const updateScrollState = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 8);
    };

    menuToggle.addEventListener("click", () => {
      setMenuOpen(!header.classList.contains("is-menu-open"));
    });

    scrim?.addEventListener("click", () => {
      setMenuOpen(false);
    });

    const closeTimers = new WeakMap<HTMLElement, number>();
    const HOVER_CLOSE_DELAY = 150;

    const cancelCloseTimer = (item: HTMLElement) => {
      const timer = closeTimers.get(item);
      if (timer !== undefined) {
        window.clearTimeout(timer);
        closeTimers.delete(item);
      }
    };

    submenuItems.forEach((item) => {
      const toggle = item.querySelector<HTMLButtonElement>(".site-header__submenu-toggle");
      if (!toggle) return;

      toggle.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();

        cancelCloseTimer(item);
        const open = !item.classList.contains("is-submenu-open");
        closeAllSubmenus(open ? item : null);
        setSubmenuOpen(item, open);
      });

      item.addEventListener("mouseenter", () => {
        if (!mobileQuery.matches) {
          cancelCloseTimer(item);
          closeAllSubmenus(item);
          setSubmenuOpen(item, true);
        }
      });

      item.addEventListener("mouseleave", () => {
        if (!mobileQuery.matches) {
          cancelCloseTimer(item);
          const timer = window.setTimeout(() => {
            setSubmenuOpen(item, false);
            closeTimers.delete(item);
          }, HOVER_CLOSE_DELAY);
          closeTimers.set(item, timer);
        }
      });

      item.addEventListener("focusin", () => {
        if (!mobileQuery.matches) {
          closeAllSubmenus(item);
          setSubmenuOpen(item, true);
        }
      });

      item.addEventListener("focusout", () => {
        if (!mobileQuery.matches) {
          window.requestAnimationFrame(() => {
            if (!item.contains(document.activeElement)) {
              setSubmenuOpen(item, false);
            }
          });
        }
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (!header.contains(target)) {
        closeAllSubmenus();

        if (mobileQuery.matches) {
          setMenuOpen(false);
        }
      }
    });

    document.addEventListener("keydown", (event) => {
      const menuOpen = header.classList.contains("is-menu-open");

      /* Keep Tab inside the drawer while it is open; the page behind the scrim
         is still focusable otherwise. The hamburger is part of the loop because
         it doubles as the close button. */
      if (event.key === "Tab" && mobileQuery.matches && menuOpen) {
        const focusables = drawerFocusables();
        if (!focusables.length) return;

        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement as HTMLElement | null;
        const inside = active ? focusables.includes(active) : false;

        if (event.shiftKey && (!inside || active === first)) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && (!inside || active === last)) {
          event.preventDefault();
          first.focus();
        }
        return;
      }

      if (event.key !== "Escape") {
        return;
      }

      const openItem = submenuItems.find((item) =>
        item.classList.contains("is-submenu-open")
      );

      if (openItem) {
        setSubmenuOpen(openItem, false);
        openItem.querySelector<HTMLButtonElement>(".site-header__submenu-toggle")?.focus();
        return;
      }

      if (mobileQuery.matches && menuOpen) {
        setMenuOpen(false);
        menuToggle.focus();
      }
    });

    window.addEventListener("resize", syncViewportState);
    window.addEventListener("scroll", updateScrollState, { passive: true });

    if ("ResizeObserver" in window) {
      new ResizeObserver(publishHeaderHeight).observe(header);
    }

    syncViewportState();
    updateScrollState();
  })();
</script>

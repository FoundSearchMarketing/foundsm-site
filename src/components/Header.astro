---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isExactPath = (href: string) => currentPath === (href.replace(/\/$/, '') || '/');
const isPathSection = (href: string) => {
  const normalizedHref = href.replace(/\/$/, '') || '/';
  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
const megaMenus = [
  {
    id: 'capabilities',
    label: 'Capabilities',
    href: '/capabilities/',
    match: 'exact',
    pillars: [
      { label: 'Paid Media', href: '/capabilities/paid-media/', desc: 'Search, social, display, and programmatic engineered as one system.' },
      { label: 'Data Activation', href: '/capabilities/data-activation/', desc: 'Your first-party data, connected to the platforms where growth happens.' },
      { label: 'Data & Analytics', href: '/capabilities/data-analytics/', desc: 'Unified data so marketing decisions are clearer, faster, and measurable.', children: [
        { label: 'Server-Side Tracking', href: '/capabilities/data-analytics/server-side-tracking/' },
      ] },
      { label: 'Performance Creative', href: '/capabilities/performance-creative/', desc: 'Fast-track creative paired with data-backed testing and CRO.' },
    ],
    panel: {
      title: 'Specialized Services',
      desc: 'Engagements built for a specific moment in your business.',
      links: [
        { label: 'Custom Builds', href: '/resources/tools/custom-builds/' },
        { label: 'AI & Automation', href: '/capabilities/ai-automation/' },
        { label: 'Ad Account Migration', href: '/capabilities/ad-account-migration/' },
        { label: 'Home Services Lead Gen', href: '/industry/home-services/' },
      ],
    },
  },
  { id: 'approach', label: 'Our Approach', href: '/our-approach/', match: 'exact', simple: true },
  { id: 'insights', label: 'Insights', href: '/insights/', match: 'section:/insights/', simple: true },
  {
    id: 'resources',
    label: 'Resources',
    href: '/resources/tools/',
    match: 'section:/resources/',
    pillars: [
      { label: 'Tools & Custom Builds', href: '/resources/tools/', desc: 'The systems we built because nothing off the shelf worked.', children: [
        { label: 'The Found Build Library', href: '/resources/tools/custom-builds/' },
      ] },
      { label: 'Whitepapers', href: '/whitepapers/first-party-data/', desc: 'Long-form research on the data problems costing you revenue.' },
      { label: 'Events', href: '/events/', desc: 'Where we have been, and where we are headed next.' },
      { label: 'Insights', href: '/insights/', desc: 'Problem-first thinking on paid media, data, and AI.' },
    ],
    panel: {
      title: 'Free Tools',
      desc: 'Run them on your own account. No sales call required.',
      links: [
        { label: 'Server-Side ROAS Calculator', href: 'https://sst-roas.foundsm.com/', newTab: true },
        { label: 'Signal Quality Assessment', href: '/signal-quiz/', newTab: true },
      ],
    },
  },
  {
    id: 'about',
    label: 'About Us',
    href: '/about-us/',
    match: 'exact',
    compact: true,
    pillars: [
      { label: 'Who We Are', href: '/about-us/', desc: 'A data engineering firm that activates paid media.' },
      { label: 'Team', href: '/team/', desc: 'The people doing the work on your account.' },
      { label: 'Newsletter', href: '/newsletter/', desc: 'Strategy, platform changes, and first invites to our events.' },
    ],
    panel: {
      title: 'Join Us',
      desc: 'We hire people who would rather build the fix than file a ticket.',
      links: [{ label: 'Open Roles', href: '/about-us/#careers' }],
    },
  },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Found Search Marketing home">
      <img
        class="site-header__logo"
        src="/images/logo.svg"
        alt="Found Search Marketing"
        width="209"
        height="43"
        loading="eager"
      />
    </a>

    <nav
      class="site-header__nav"
      id="primary-navigation"
      aria-label="Primary"
      aria-hidden="true"
    >
      <ul class="site-header__menu" role="list">
        {megaMenus.map((menu) => (
          menu.simple ? (
          <li class="site-header__item">
            <a class="site-header__link" href={menu.href} aria-current={(menu.match === 'exact' ? isExactPath(menu.href) : isPathSection(menu.match.replace('section:',''))) ? 'page' : undefined}>{menu.label}</a>
          </li>
          ) : (
          <li class="site-header__item site-header__item--has-submenu site-header__item--mega">
            <a class="site-header__link" href={menu.href} aria-current={(menu.match === 'exact' ? isExactPath(menu.href) : isPathSection(menu.match.replace('section:',''))) ? 'page' : undefined}>{menu.label}</a>
            <button class="site-header__submenu-toggle" type="button" aria-label={`Toggle ${menu.label} submenu`} aria-expanded="false" aria-controls={`submenu-${menu.id}`}>
              <span class="site-header__sr-only">Toggle {menu.label} submenu</span>
            </button>
            <div class={`site-header__submenu site-header__mega${menu.compact ? ' site-header__mega--compact' : ''}`} id={`submenu-${menu.id}`} aria-hidden="true">
              <div class="site-header__mega-inner">
                <div class="site-header__mega-pillars">
                  {menu.pillars.map((p) => (
                    <div class="site-header__pillar">
                      <a class="site-header__pillar-link" href={p.href}>{p.label}</a>
                      <p class="site-header__pillar-desc">{p.desc}</p>
                      {p.children && (
                        <ul class="site-header__pillar-children" role="list">
                          {p.children.map((c) => <li><a class="site-header__child-link" href={c.href}>{c.label}</a></li>)}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
                <div class="site-header__mega-panel">
                  <p class="site-header__mega-panel-title">{menu.panel.title}</p>
                  <p class="site-header__mega-panel-desc">{menu.panel.desc}</p>
                  <ul class="site-header__mega-panel-list" role="list">
                    {menu.panel.links.map((l) => (
                      <li><a class="site-header__child-link" href={l.href} target={l.newTab ? '_blank' : undefined} rel={l.newTab ? 'noopener noreferrer' : undefined}>{l.label}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </li>
          )
        ))}
        <li class="site-header__item site-header__item--cta">
          <a class="site-header__link site-header__cta site-header__cta--primary" href="/contact-us/">Contact Us</a>
        </li>
        <li class="site-header__item site-header__item--cta">
          <a class="site-header__link site-header__cta site-header__cta--secondary" href="/about-us/#careers">Join Us</a>
        </li>
      </ul>
    </nav>

    <button
      class="site-header__menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-controls="primary-navigation"
      aria-expanded="false"
    >
      <svg class="site-header__menu-icon site-header__menu-icon--open" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
      </svg>
      <svg class="site-header__menu-icon site-header__menu-icon--close" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
      </svg>
      <span class="site-header__sr-only">Toggle navigation menu</span>
    </button>
  </div>

  <div class="site-header__scrim" aria-hidden="true"></div>
</header>

<style is:global>

/* ---------- Mega menu panels ---------- */
.site-header .site-header__item--mega { position: static; }

.site-header .site-header__mega {
  max-inline-size: none;
  position: absolute;
  inset-block-start: 100%;
  inset-inline: 0;
  inline-size: 100%;
  display: block;
  padding: 0;
  border-block-start: 1px solid rgba(35, 31, 32, 0.12);
  background: var(--color-white);
  box-shadow: 0 18px 30px rgba(0, 0, 0, 0.12);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(0.4rem);
  transition: opacity var(--transition-base), transform var(--transition-base), visibility var(--transition-base);
}

.site-header__mega::before {
  content: "";
  position: absolute;
  inset-block-end: 100%;
  inset-inline: 0;
  block-size: 12px;
}

.site-header .site-header__item--mega:is(:focus-within, .is-submenu-open) > .site-header__mega {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0);
}

@media (hover: hover) and (pointer: fine) {
  .site-header .site-header__item--mega:hover > .site-header__mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
}

.site-header__mega-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(17rem, 22rem);
  gap: 3rem;
  inline-size: min(calc(100% - (2 * var(--gutter))), var(--content-max-width));
  margin-inline: auto;
  padding-block: 2.75rem 3rem;
}

.site-header__mega-pillars {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2rem 3rem;
  align-content: start;
}

.site-header__mega--compact .site-header__mega-pillars {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rem;
}

.site-header__pillar-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: #231f20;
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0;
}

.site-header__pillar-link::after {
  content: "\203A";
  font-size: 1.15em;
  line-height: 1;
  transform: translateY(-0.05em);
  transition: transform var(--transition-base);
}

.site-header__pillar-link:hover,
.site-header__pillar-link:focus-visible { color: var(--color-primary); }

.site-header__pillar-link:hover::after { transform: translate(0.2rem, -0.05em); }

.site-header__pillar-desc {
  margin: 0.55rem 0 0;
  max-inline-size: 26rem;
  color: rgba(35, 31, 32, 0.72);
  font-size: 0.95rem;
  font-weight: 400;
  line-height: 1.5;
}

.site-header__pillar-children {
  display: grid;
  gap: 0.4rem;
  margin: 0.85rem 0 0;
  padding: 0 0 0 0.9rem;
  border-inline-start: 2px solid var(--color-primary);
  list-style: none;
}

.site-header__child-link {
  display: inline-block;
  color: #231f20;
  font-size: 0.95rem;
  font-weight: 500;
  line-height: 1.4;
}

.site-header__child-link:hover,
.site-header__child-link:focus-visible { color: var(--color-primary); }

.site-header__mega-panel {
  padding: 1.85rem;
  border-inline-start: 3px solid var(--color-primary);
  background: #f4f5f3;
}

.site-header__mega-panel-title {
  margin: 0;
  color: #231f20;
  font-size: 1.15rem;
  font-weight: 700;
  line-height: 1.2;
}

.site-header__mega-panel-desc {
  margin: 0.5rem 0 0;
  color: rgba(35, 31, 32, 0.72);
  font-size: 0.9rem;
  line-height: 1.5;
}

.site-header__mega-panel-list {
  display: grid;
  gap: 0.6rem;
  margin: 1.15rem 0 0;
  padding: 0;
  list-style: none;
}

@media (max-width: 1024px) {
  /* These need to out-specify the base `.site-header .site-header__mega` rules
     above (0,2,0). At 0,1,0 the base won, so the panels stayed absolute and all
     three stacked at inset-block-start: 100% of the drawer, off the bottom and
     on top of each other. */
  .site-header .site-header__item--mega { position: relative; }

  .site-header .site-header__mega {
    position: static;
    inset: auto;
    display: none;
    inline-size: 100%;
    border: 0;
    box-shadow: none;
    background: transparent;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }

  .site-header .site-header__item--mega.is-submenu-open > .site-header__mega { display: block; }

  .site-header .site-header__item--mega:is(:hover, :focus-within):not(.is-submenu-open) > .site-header__mega { display: none; }

  .site-header__mega-inner { display: block; inline-size: 100%; padding-block: 0.5rem 1rem; }

  .site-header__mega-pillars,
  .site-header__mega--compact .site-header__mega-pillars { display: block; }

  .site-header__pillar { padding-block: 0.75rem; }

  .site-header__pillar-link { font-size: 1.1rem; }

  .site-header__pillar-desc { display: none; }

  .site-header__mega-panel { margin-block-start: 1rem; padding: 1.25rem; }

  .site-header__mega-panel-desc { display: none; }
}
</style>

<script>
  (() => {
    const header = document.querySelector<HTMLElement>(".site-header");
    const nav = document.querySelector<HTMLElement>(".site-header__nav");
    const menuToggle = document.querySelector<HTMLButtonElement>(".site-header__menu-toggle");
    const scrim = document.querySelector<HTMLElement>(".site-header__scrim");
    const submenuItems = Array.from(
      document.querySelectorAll<HTMLElement>(".site-header__item--has-submenu")
    );
    const mobileQuery = window.matchMedia("(max-width: 1024px)");

    if (!header || !nav || !menuToggle) {
      return;
    }

    /* The drawer and scrim are fixed to the viewport, so they need the real
       header height. The --header-height token reads 85px below 1025px while
       the header actually renders at 66px, so publish the measured value. */
    const publishHeaderHeight = () => {
      const { height } = header.getBoundingClientRect();
      if (height > 0) {
        header.style.setProperty("--header-h", `${Math.round(height)}px`);
      }
    };

    const isFocusable = (el: HTMLElement) =>
      el.getClientRects().length > 0 && getComputedStyle(el).visibility !== "hidden";

    const drawerFocusables = () =>
      [
        menuToggle,
        ...Array.from(nav.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")),
      ].filter(isFocusable);

    const setSubmenuOpen = (item: HTMLElement, open: boolean) => {
      const toggle = item.querySelector<HTMLButtonElement>(".site-header__submenu-toggle");
      const submenu = item.querySelector<HTMLElement>(".site-header__submenu");
      if (!toggle || !submenu) return;

      item.classList.toggle("is-submenu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      submenu.setAttribute("aria-hidden", String(!open));
    };

    const closeAllSubmenus = (except: HTMLElement | null = null) => {
      submenuItems.forEach((item) => {
        if (item !== except) {
          setSubmenuOpen(item, false);
        }
      });
    };

    const setMenuOpen = (open: boolean) => {
      const isMobile = mobileQuery.matches;

      if (open && isMobile) {
        publishHeaderHeight();
      }

      header.classList.toggle("is-menu-open", open);
      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu"
      );
      nav.setAttribute("aria-hidden", isMobile ? String(!open) : "false");
      document.documentElement.classList.toggle("has-menu-open", isMobile && open);

      if (!open) {
        closeAllSubmenus();
        return;
      }

      /* Move focus into the drawer so keyboard and screen reader users are not
         left behind the scrim. Waits a frame for visibility to flip. */
      if (isMobile) {
        window.requestAnimationFrame(() => {
          const first = nav.querySelector<HTMLElement>("a[href], button:not([disabled])");
          if (first && isFocusable(first)) {
            first.focus();
          }
        });
      }
    };

    const syncViewportState = () => {
      publishHeaderHeight();

      if (mobileQuery.matches) {
        const open = header.classList.contains("is-menu-open");
        nav.setAttribute("aria-hidden", String(!open));
        document.documentElement.classList.toggle("has-menu-open", open);
      } else {
        header.classList.remove("is-menu-open");
        document.documentElement.classList.remove("has-menu-open");
        nav.setAttribute("aria-hidden", "false");
        closeAllSubmenus();
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open navigation menu");
      }
    };

    const updateScrollState = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 8);
    };

    menuToggle.addEventListener("click", () => {
      setMenuOpen(!header.classList.contains("is-menu-open"));
    });

    scrim?.addEventListener("click", () => {
      setMenuOpen(false);
    });

    const closeTimers = new WeakMap<HTMLElement, number>();
    const HOVER_CLOSE_DELAY = 150;

    const cancelCloseTimer = (item: HTMLElement) => {
      const timer = closeTimers.get(item);
      if (timer !== undefined) {
        window.clearTimeout(timer);
        closeTimers.delete(item);
      }
    };

    submenuItems.forEach((item) => {
      const toggle = item.querySelector<HTMLButtonElement>(".site-header__submenu-toggle");
      if (!toggle) return;

      toggle.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();

        cancelCloseTimer(item);
        const open = !item.classList.contains("is-submenu-open");
        closeAllSubmenus(open ? item : null);
        setSubmenuOpen(item, open);
      });

      item.addEventListener("mouseenter", () => {
        if (!mobileQuery.matches) {
          cancelCloseTimer(item);
          closeAllSubmenus(item);
          setSubmenuOpen(item, true);
        }
      });

      item.addEventListener("mouseleave", () => {
        if (!mobileQuery.matches) {
          cancelCloseTimer(item);
          const timer = window.setTimeout(() => {
            setSubmenuOpen(item, false);
            closeTimers.delete(item);
          }, HOVER_CLOSE_DELAY);
          closeTimers.set(item, timer);
        }
      });

      item.addEventListener("focusin", () => {
        if (!mobileQuery.matches) {
          closeAllSubmenus(item);
          setSubmenuOpen(item, true);
        }
      });

      item.addEventListener("focusout", () => {
        if (!mobileQuery.matches) {
          window.requestAnimationFrame(() => {
            if (!item.contains(document.activeElement)) {
              setSubmenuOpen(item, false);
            }
          });
        }
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (!header.contains(target)) {
        closeAllSubmenus();

        if (mobileQuery.matches) {
          setMenuOpen(false);
        }
      }
    });

    document.addEventListener("keydown", (event) => {
      const menuOpen = header.classList.contains("is-menu-open");

      /* Keep Tab inside the drawer while it is open; the page behind the scrim
         is still focusable otherwise. The hamburger is part of the loop because
         it doubles as the close button. */
      if (event.key === "Tab" && mobileQuery.matches && menuOpen) {
        const focusables = drawerFocusables();
        if (!focusables.length) return;

        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        const active = document.activeElement as HTMLElement | null;
        const inside = active ? focusables.includes(active) : false;

        if (event.shiftKey && (!inside || active === first)) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && (!inside || active === last)) {
          event.preventDefault();
          first.focus();
        }
        return;
      }

      if (event.key !== "Escape") {
        return;
      }

      const openItem = submenuItems.find((item) =>
        item.classList.contains("is-submenu-open")
      );

      if (openItem) {
        setSubmenuOpen(openItem, false);
        openItem.querySelector<HTMLButtonElement>(".site-header__submenu-toggle")?.focus();
        return;
      }

      if (mobileQuery.matches && menuOpen) {
        setMenuOpen(false);
        menuToggle.focus();
      }
    });

    window.addEventListener("resize", syncViewportState);
    window.addEventListener("scroll", updateScrollState, { passive: true });

    if ("ResizeObserver" in window) {
      new ResizeObserver(publishHeaderHeight).observe(header);
    }

    syncViewportState();
    updateScrollState();
  })();
</script>

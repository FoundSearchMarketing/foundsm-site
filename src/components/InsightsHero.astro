---
import MediaAsset from './MediaAsset.astro';

interface Props {
  headline?: string;
  body?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  headline = 'Where Bold Ideas Are Found.',
  body = 'Great performance begins by staying sharp. Tap into fresh insights, news, and forward-thinking strategies from our team and beyond.',
  imageSrc,
  imageAlt = '',
} = Astro.props;
---

<section class="insights-hero" aria-label={headline}>
  <div class:list={['insights-hero__inner', { 'insights-hero__inner--text-only': !imageSrc }]}>
    <div class="insights-hero__copy">
      <h1 class="insights-hero__headline">{headline}</h1>
      <p class="insights-hero__body">{body}</p>
    </div>
    {imageSrc && (
      <figure class="insights-hero__figure" aria-hidden={imageAlt ? undefined : 'true'}>
        <MediaAsset
          class="insights-hero__media"
          src={imageSrc}
          alt={imageAlt}
          width="660"
          height="440"
          loading="eager"
        />
      </figure>
    )}
  </div>
</section>

<style>
  /* Values sourced from foundsm.wpress (page `data-elementor-id="2283"`,
     Elementor kit 5): section bg #000, margin-bottom 50px, gutter 25px, 100px
     column gap, copy column behavior, and heading Fraunces 60px/65px/900
     desktop and 38px/42px/900 tablet/mobile. Letter spacing is normalized
     to match the project CSS guidance. */

  .insights-hero {
    background-color: var(--color-surface-muted);
    color: var(--color-dark);
    margin-block-end: 50px;
  }

  .insights-hero__inner {
    display: grid;
    grid-template-columns: var(--split-hero-grid-columns);
    align-items: start;
    column-gap: var(--split-hero-gap);
    inline-size: min(calc(100% - (2 * var(--page-gutter))), var(--content-max-width));
    margin-inline: auto;
    padding-block: var(--split-hero-padding-block-start) var(--split-hero-padding-block-end);
  }

  .insights-hero__inner--text-only {
    grid-template-columns: minmax(0, 52rem);
  }

  .insights-hero__copy {
    min-inline-size: 0;
    padding: 10px;
  }

  .insights-hero__headline {
    margin: 0;
    color: var(--color-dark);
    font-family: 'Fraunces', Georgia, serif;
    font-size: 60px;
    font-weight: 900;
    line-height: 65px;
    letter-spacing: 0;
  }

  .insights-hero__body {
    margin: 20px 0;
    color: var(--color-dark);
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 36px;
  }

  /* Media matches the shared split-hero geometry used on other pages. */
  .insights-hero__figure {
    margin: var(--split-hero-media-margin-block-start) 0 0;
    overflow: hidden;
    border-radius: var(--split-hero-media-radius);
    aspect-ratio: var(--split-hero-media-aspect-ratio);
  }

  .insights-hero__figure :global(.insights-hero__media) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  @media (min-width: 1025px) {
    .insights-hero__inner {
      inline-size: var(--split-hero-content-width);
    }

    .insights-hero__copy {
      padding-inline: var(--split-hero-copy-padding-inline-start) 0;
    }
  }

  @media (max-width: 1024px) {
    .insights-hero__inner {
      display: block;
      min-block-size: 0;
      padding-block: var(--split-hero-padding-block-start) var(--split-hero-padding-block-end);
    }

    .insights-hero__headline {
      font-size: 38px;
      line-height: 42px;
      letter-spacing: 0;
    }

    .insights-hero__body {
      font-size: 18px;
      line-height: 30px;
    }

    .insights-hero__figure {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .insights-hero__inner {
      inline-size: min(calc(100% - (2 * var(--page-gutter))), var(--content-max-width));
    }
  }
</style>

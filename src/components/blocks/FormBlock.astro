---
interface Props {
  heading?: string;
  subheading?: string;
  hubspotFormId?: string;
  /** ActiveCampaign form id. When set, this is the form the block embeds. */
  acFormId?: string;
  theme?: 'light' | 'dark';
}

/*
  The contact HubSpot form (test-route demo, and the old dataconnect fallback)
  now submits through ActiveCampaign form 8, the same form as /contact-us/
  and /dataconnect/. Any other HubSpot id renders nothing.
*/
const CONTACT_HUBSPOT_FORM_ID = '77ee07f7-2567-46d2-9255-ff9e410fdf6a';
const CONTACT_AC_FORM_ID = '8';

const { heading, subheading, hubspotFormId, acFormId, theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
const resolvedAcFormId =
  acFormId || (hubspotFormId === CONTACT_HUBSPOT_FORM_ID ? CONTACT_AC_FORM_ID : undefined);
---

<section class={`section ${isDark ? 'section--dark' : 'section--light'}`} aria-label={heading || 'Form'}>
  <div class="container">
    <div class="lp-form-block">
      {(heading || subheading) && (
        <div class="section-header section-header--center fade-in-up">
          {heading && <h2>{heading}</h2>}
          {subheading && <p class="section-header__text">{subheading}</p>}
        </div>
      )}
      {resolvedAcFormId && (
        <div class={`_form_${resolvedAcFormId} lp-form-block__container fade-in-up`} id={`lp-ac-form-${resolvedAcFormId}`}></div>
      )}
    </div>
  </div>
  {resolvedAcFormId && (
    <script is:inline src={`https://foundsm.activehosted.com/f/embed.php?id=${resolvedAcFormId}`} charset="utf-8" defer></script>
  )}
</section>

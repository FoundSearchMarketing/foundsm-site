---
import LogoMarquee from '../modern/LogoMarquee.astro';

interface Logo {
  url?: string;
  src?: string;
  name?: string;
  alt?: string;
  imageAlt?: string;
  videoUrl?: string;
}

interface Props {
  heading?: string;
  logos?: Logo[];
  displayMode?: 'static' | 'marquee';
  theme?: 'light' | 'muted' | 'dark';
  density?: 'compact' | 'standard';
}

const { heading, logos = [], displayMode = 'static', theme = 'light', density = 'standard' } = Astro.props;
const normalizedLogos = logos
  .map((logo) => ({
    src: logo.url || logo.src || logo.videoUrl,
    alt: logo.alt || logo.imageAlt || logo.name || '',
  }))
  .filter((logo): logo is { src: string; alt: string } => Boolean(logo.src));
const marqueeLogos = normalizedLogos;
---

{displayMode === 'marquee' ? (
  <LogoMarquee title={heading} logos={marqueeLogos} theme={theme} />
) : (
  <section class={`section lp-logo-bar lp-logo-bar--${theme} lp-logo-bar--${density}${theme === 'dark' ? ' dark-band' : ''}`} aria-label={heading || 'Partners'}>
    <div class="container">
      {heading && <h2 class="logo-marquee__heading fade-in-up">{heading}</h2>}
      <div class="partners__grid fade-in-up">
        {normalizedLogos.map((logo) => (
          <div class="partners__badge">
            <img src={logo.src} alt={logo.alt} loading="lazy" width="160" height="80" />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .lp-logo-bar--muted {
    background: #f2f3f2;
  }

  /* The dark theme takes its field and artwork from the canonical .dark-band
     treatment in global.css, so only the type and badge tuning lives here. */
  .lp-logo-bar--dark .logo-marquee__heading {
    color: var(--color-white);
  }

  .lp-logo-bar--dark .partners__grid {
    gap: var(--space-md) var(--space-lg);
  }

  /* Client marks sit on white chips rather than being knocked out. These logos
     come in as-supplied artwork: some carry black type that vanishes against
     the field, others are white type on a solid colour block that a knockout
     would flatten into a slab. A chip keeps every mark legible and on-brand. */
  .lp-logo-bar--dark .partners__badge {
    display: grid;
    place-items: center;
    block-size: auto;
    padding: 0.85rem 1.4rem;
    border-radius: 0.75rem;
    background: var(--color-white);
    opacity: 1;
    filter: none;
  }

  .lp-logo-bar--dark .partners__badge:hover {
    opacity: 1;
    filter: none;
  }

  /* Sized off the tallest lockup in the row rather than the shortest: stacked
     marks like Capital carry a second line of type that is unreadable at
     wordmark height. Width is capped so a very wide mark scales down instead
     of dominating the row. */
  .lp-logo-bar--dark .partners__badge img {
    block-size: 3.5rem;
    inline-size: auto;
    max-inline-size: 13rem;
    object-fit: contain;
  }

  .lp-logo-bar--compact {
    padding-block: 2.5rem;
  }
</style>

---
import LogoMarquee from '../modern/LogoMarquee.astro';

interface Logo {
  url?: string;
  src?: string;
  name?: string;
  alt?: string;
  imageAlt?: string;
  videoUrl?: string;
}

interface Props {
  heading?: string;
  logos?: Logo[];
  displayMode?: 'static' | 'marquee';
  theme?: 'light' | 'muted' | 'dark';
  density?: 'compact' | 'standard';
}

const { heading, logos = [], displayMode = 'static', theme = 'light', density = 'standard' } = Astro.props;
const normalizedLogos = logos
  .map((logo) => ({
    src: logo.url || logo.src || logo.videoUrl,
    alt: logo.alt || logo.imageAlt || logo.name || '',
  }))
  .filter((logo): logo is { src: string; alt: string } => Boolean(logo.src));
const marqueeLogos = normalizedLogos;
const isDark = theme === 'dark';
---

{displayMode === 'marquee' ? (
  <LogoMarquee title={heading} logos={marqueeLogos} theme={theme} />
) : (
  <section
    class={`section lp-logo-bar lp-logo-bar--${theme} lp-logo-bar--${density}${isDark ? ' dark-band' : ''}`}
    aria-label={heading || 'Partners'}
  >
    <div class="container">
      {heading && <h2 class="logo-marquee__heading fade-in-up">{heading}</h2>}
      <div class="partners__grid fade-in-up">
        {normalizedLogos.map((logo) => (
          <div class="partners__badge">
            <img src={logo.src} alt={logo.alt} loading="lazy" width="160" height="80" />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .lp-logo-bar--muted {
    background: #f2f3f2;
  }

  .lp-logo-bar--compact {
    padding-block: 2.5rem;
  }

  /* Client logos read in full colour here, the way they do on the home page
     marquee, rather than taking the grayscale partner-badge treatment. */
  .lp-logo-bar :global(.partners__badge),
  .lp-logo-bar :global(.partners__badge:hover) {
    opacity: 1;
    filter: none;
  }

  /* Dark logo bar: the canonical black band from global.css carries the
     background, and each logo sits on a white tile so dark-inked marks stay
     legible against it. */
  .lp-logo-bar--dark :global(.logo-marquee__heading) {
    color: var(--color-white);
  }

  .lp-logo-bar--dark :global(.partners__grid) {
    gap: var(--space-lg) var(--space-2xl);
  }

  .lp-logo-bar--dark :global(.partners__badge) {
    height: auto;
    border-radius: 12px;
    background: var(--color-white);
    padding: 0.875rem 1.25rem;
  }

  .lp-logo-bar--dark :global(.partners__badge img) {
    display: block;
    height: 2.5rem;
    width: auto;
  }
</style>

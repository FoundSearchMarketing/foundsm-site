---
interface Props {
  anchor: string;
  href: string;
  image: string;
  imageAlt: string;
  heading: string;
  lead: string;
  bodyHtml: string;
  label: string;
}

const { anchor, href, image, imageAlt, heading, lead, bodyHtml, label } = Astro.props;
---

<article class="home2-card" id={anchor}>
  <img src={image} alt={imageAlt} width="1600" height="900" loading="lazy" />
  <div class="home2-card__body">
    <h3 class="home2-card__title" id={`${anchor}-title`}>{heading}</h3>
    <p class="home2-card__text">{lead}</p>
    {bodyHtml && <div class="capabilities-card__copy" set:html={bodyHtml} />}
    <a class="home2-more" href={href}>{label}</a>
  </div>
</article>

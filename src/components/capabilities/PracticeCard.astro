---
interface Props {
  anchor: string;
  href: string;
  image: string;
  imageAlt: string;
  heading: string;
  lead: string;
  label: string;
}

const { anchor, href, image, imageAlt, heading, lead, label } = Astro.props;
---

<a class="home2-card" id={anchor} href={href}>
  <img src={image} alt={imageAlt} width="1600" height="900" loading="lazy" />
  <div class="home2-card__body">
    <h3 class="home2-card__title" id={`${anchor}-title`}>{heading}</h3>
    <p class="home2-card__text">{lead}</p>
    <span class="home2-more">{label}</span>
  </div>
</a>

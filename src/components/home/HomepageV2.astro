        </div>
        <p class="home2-body">{content.engage.outro}</p>
        <a class="btn btn--primary" href={content.engage.cta.href}>{content.engage.cta.label}</a>
      </div>
      <aside class="home2-panel" aria-label={content.engage.existing.eyebrow}>
        <svg class="home2-panel__loop" viewBox="0 0 320 320" aria-hidden="true" focusable="false">
          <circle class="home2-panel__ring" cx="160" cy="160" r="118" />
          <g class="home2-panel__orbit">
            <path class="home2-panel__arc" d="M160 42A118 118 0 0 1 278 160" />
            <circle class="home2-panel__node home2-panel__node--lit" cx="278" cy="160" r="9" />
            <circle class="home2-panel__node" cx="160" cy="278" r="6" />
            <circle class="home2-panel__node" cx="42" cy="160" r="6" />
            <circle class="home2-panel__node" cx="160" cy="42" r="6" />
          </g>
          <circle class="home2-panel__core" cx="160" cy="160" r="7" />
        </svg>
        <div class="home2-panel__copy">
          <p class="home2-eyebrow home2-eyebrow--light">{content.engage.existing.eyebrow}</p>
          <p class="home2-display home2-panel__title">{content.engage.existing.heading}</p>
          <p>{content.engage.existing.body}</p>
        </div>
        <a class="btn btn--secondary-white btn--sm home2-panel__cta" href={content.engage.existing.cta.href}>{content.engage.existing.cta.label}</a>
      </aside>
    </div>
  </section>

  <section class="home2-section home2-team" id="team" aria-labelledby="home2-team-title">
    <div class="home2-shell home2-team__inner">
      <div class="home2-team__copy">
        <p class="home2-eyebrow">{content.team.eyebrow}</p>
        <h2 id="home2-team-title">{content.team.heading}</h2>
        <p class="home2-team__lead">{content.team.lead}</p>
        <p class="home2-team__body">{content.team.body}</p>
        <a class="btn btn--outline" href={content.team.cta.href}>{content.team.cta.label}</a>
      </div>
      {teamImage && (
        <img class="home2-team__image" src={teamImage} alt={content.team.imageAlt} width="742" height="739" loading="lazy" />
      )}
    </div>
  </section>

  <section class="home2-section home2-section--dark home2-research" id="research" aria-labelledby="home2-research-eyebrow">
    <div class="home2-shell home2-research__inner">
      <p class="home2-eyebrow home2-eyebrow--light" id="home2-research-eyebrow">{content.research.eyebrow}</p>
      <div class="home2-research__grid">
      <div class="home2-research__col">
        <h2 id="home2-brief-title">{content.research.brief.heading}</h2>
        <p class="home2-research__intro">{content.research.brief.intro}</p>
        <a class="home2-brief" href={content.research.brief.cta.href}>
          <span class="home2-brief__issue">{content.research.brief.issueLabel}</span>
          <span class="home2-display home2-brief__title">{content.research.brief.title}</span>
          <p class="home2-brief__dek">{content.research.brief.dek}</p>
          <ul class="home2-brief__contents">
            <li class="home2-label home2-brief__contents-heading">{content.research.brief.contentsHeading}</li>
            {content.research.brief.contents.map((item) => <li>{item}</li>)}
          </ul>
          <span class="home2-more home2-more--light">{content.research.brief.cta.label}</span>
        </a>
        <form
          class="home2-subscribe"
          method="post"
          action={content.research.brief.subscribeFallback.href}
          data-home2-brief
          data-portal={homeV2Forms.brief.portalId}
          data-form={homeV2Forms.brief.formId}
          data-success={content.research.brief.subscribeSuccess}
          data-error={content.research.brief.subscribeError}
          data-fallback-href={content.research.brief.subscribeFallback.href}
          data-fallback-label={content.research.brief.subscribeFallback.label}
        >
          <div class="home2-subscribe__field">
            <label for="home2-brief-email">{content.research.brief.subscribeLabel}</label>
            <input class="home2-input" id="home2-brief-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
          </div>
          <button class="btn btn--primary" type="submit">{content.research.brief.subscribeButton}</button>
          <p class="home2-form__status home2-form__status--light" role="status" aria-live="polite" hidden></p>
        </form>
      </div>

      <div class="home2-research__col home2-research__col--signals">
        <h2 id="home2-signals-title">{content.research.signals.heading}</h2>
        <p class="home2-research__intro">{content.research.signals.intro}</p>
        <ul class="home2-signals" aria-labelledby="home2-signals-title">
          {signalItems.map((signal) => (
            <li>
              <a href={signal.href}>
                <span class="home2-signals__label">{signal.label}</span>
                <span class="home2-signals__title">{signal.title}</span>
                {signal.summary && <span class="home2-signals__summary">{signal.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
        {content.research.signals.note && <p class="home2-signals__note">{content.research.signals.note}</p>}
        <a class="home2-more home2-more--light" href={content.research.signals.allLink.href}>{content.research.signals.allLink.label}</a>
      </div>
      </div>
    </div>
  </section>

  <section class="home2-section home2-recognition" id="recognition" aria-labelledby="home2-recognition-title">
    <div class="home2-shell home2-recognition__inner">
      <div class="home2-head home2-recognition__copy">
        <p class="home2-eyebrow">{content.recognition.eyebrow}</p>
        <h2 id="home2-recognition-title">{content.recognition.heading}</h2>
        <p>{content.recognition.intro}</p>
      </div>
      <div class="home2-recognition__proof">
        {partnerLogos.length > 0 && (
          <div class="home2-partners" aria-label="Partner certifications">
            {partnerLogos.map((logo) => (
              <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} loading="lazy" />
            ))}
          </div>
        )}
        <div class="home2-badges">
          {content.recognition.cards.map((card) => (
            <div class="home2-badge">
              <span class="home2-label home2-badge__label">{card.title}</span>
              <span class="home2-badge__text">{card.body}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="home2-section home2-section--paper home2-talk" id="home2-talk" aria-labelledby="home2-talk-title">
    <div class="home2-shell home2-talk__inner">
      <div class="home2-head home2-talk__copy">
        <p class="home2-eyebrow">{content.talk.eyebrow}</p>
        <h2 id="home2-talk-title">{content.talk.heading}</h2>
        <p>{content.talk.intro}</p>
      </div>
      <form
        class="home2-form"
        method="post"
        action={homeV2Forms.contact.action}
        data-home2-contact
        data-success={content.talk.success}
        data-error={content.talk.error}
        data-fallback-href={content.talk.fallback.href}
        data-fallback-label={content.talk.fallback.label}
      >
        {Object.entries(homeV2Forms.contact.hidden).map(([name, value]) => (
          <input type="hidden" name={name} value={value} />
        ))}
        <input type="hidden" name="firstname" value="" />
        <input type="hidden" name="lastname" value="" />
        <div class="home2-form__fields">
          <div class="home2-form__field">
            <label for="home2-talk-name">{content.talk.fields.name}</label>
            <input id="home2-talk-name" name="fullname" type="text" autocomplete="name" required />
          </div>
          <div class="home2-form__field">
            <label for="home2-talk-email">{content.talk.fields.email}</label>
            <input id="home2-talk-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="home2-form__field home2-form__field--wide">
            <label for="home2-talk-notes">{content.talk.fields.notes}</label>
            <textarea id="home2-talk-notes" name={homeV2Forms.contact.messageField} rows="3"></textarea>
          </div>
          <div class="home2-form__actions">
            <button class="btn btn--primary" type="submit">{content.talk.button}</button>
          </div>
        </div>
        <p class="home2-form__status" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>
</div>

<script>
  type FormState = 'idle' | 'sending' | 'sent' | 'error';

  const showStatus = (form: HTMLFormElement, message: string, fallback?: { href: string; label: string }) => {
    const status = form.querySelector<HTMLElement>('.home2-form__status');
    if (!status) return;
    status.replaceChildren();
    status.append(document.createTextNode(message));
    if (fallback) {
      status.append(document.createTextNode(' '));
      const link = document.createElement('a');
      link.href = fallback.href;
      link.textContent = fallback.label;
      status.append(link);
    }
    status.hidden = false;
  };

  const setState = (form: HTMLFormElement, state: FormState) => {
    form.dataset.state = state;
  };

  const fallbackFor = (form: HTMLFormElement) =>
    form.dataset.fallbackHref && form.dataset.fallbackLabel
      ? { href: form.dataset.fallbackHref, label: form.dataset.fallbackLabel }
      : undefined;

  /* Work card: 'rest' shows the finished chart, 'armed' holds frame 0 while
     off screen, 'play' runs the sequence once the panel is 55% visible. */
  const initRoas = (root: HTMLElement) => {
    const panel = root.querySelector<HTMLElement>('[data-home2-roas]');
    if (!panel) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || typeof IntersectionObserver !== 'function') return;

    let state: 'rest' | 'armed' | 'play' = 'rest';
    let seen = false;
    let raf = 0;
    let done = 0;

    const set = (next: typeof state) => {
      state = next;
      panel.classList.toggle('is-armed', next === 'armed');
      panel.classList.toggle('is-play', next === 'play');
    };
    const arm = () => {
      window.clearTimeout(done);
      window.cancelAnimationFrame(raf);
      if (state === 'play') {
        // One frame without animations so the browser drops them, then re-arm from frame 0.
        set('rest');
        raf = window.requestAnimationFrame(() => {
          raf = window.requestAnimationFrame(() => set('armed'));
        });
      } else if (state === 'rest') {
        set('armed');
      }
    };
    const play = () => {
      window.cancelAnimationFrame(raf);
      window.clearTimeout(done);
      if (state === 'play') {
        set('rest');
        void panel.offsetWidth;
      }
      set('play');
      done = window.setTimeout(() => set('rest'), 5900);
    };

    new IntersectionObserver(
      (entries) => {
        const entry = entries[entries.length - 1];
        if (entry.intersectionRatio >= 0.55) {
          if (!seen) {
            seen = true;
            play();
          }
        } else if (!entry.isIntersecting || !seen) {
          seen = false;
          arm();
        }
      },
      { threshold: [0, 0.55] },
    ).observe(panel);
  };

  /* Talk with us: posts to the ActiveCampaign contact form the way its embed
     does (multipart POST, JSON reply), so no-JS visitors still get a working
     plain POST. The single "Full name" field is split for AC's first/last. */
  const initContact = (root: HTMLElement) => {
    const form = root.querySelector<HTMLFormElement>('[data-home2-contact]');
    if (!form) return;
    const fullName = form.elements.namedItem('fullname') as HTMLInputElement | null;
    const firstName = form.elements.namedItem('firstname') as HTMLInputElement | null;
    const lastName = form.elements.namedItem('lastname') as HTMLInputElement | null;
    const fields = form.querySelector<HTMLElement>('.home2-form__fields');

    const nameParts = () => (fullName?.value.trim() || '').split(/\s+/).filter(Boolean);
    const validateName = () => {
      if (!fullName) return;
      fullName.setCustomValidity(fullName.value.trim() && nameParts().length < 2 ? 'Please enter your first and last name.' : '');
    };
    fullName?.addEventListener('input', validateName);
    fullName?.addEventListener('blur', validateName);

    form.addEventListener('submit', async (event) => {
      validateName();
      if (!form.checkValidity()) return;
      event.preventDefault();

      const parts = nameParts();
      if (firstName) firstName.value = parts[0] || '';
      if (lastName) lastName.value = parts.slice(1).join(' ');
      const body = new FormData(form);
      body.delete('fullname');

      setState(form, 'sending');
      try {
        const response = await fetch(`${form.action}?jsonp=true`, {
          method: 'POST',
          body,
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = (await response.json().catch(() => ({}))) as { js?: string };
        if (typeof payload.js === 'string' && payload.js.includes('_show_error')) throw new Error('rejected');
        if (fields) fields.hidden = true;
        setState(form, 'sent');
        showStatus(form, form.dataset.success || 'Thanks, we will be in touch.');
      } catch {
        setState(form, 'error');
        showStatus(form, form.dataset.error || 'That did not go through.', fallbackFor(form));
      }
    });
  };

  /* The Brief: email-only subscribe through the HubSpot forms endpoint the
     newsletter page uses. The hutk cookie ties it to existing tracking. */
  const initBrief = (root: HTMLElement) => {
    const form = root.querySelector<HTMLFormElement>('[data-home2-brief]');
    if (!form) return;
    const email = form.elements.namedItem('email') as HTMLInputElement | null;
    const portal = form.dataset.portal;
    const formId = form.dataset.form;
    if (!email || !portal || !formId) return;

    form.addEventListener('submit', async (event) => {
      if (!form.checkValidity()) return;
      event.preventDefault();
      const hutk = document.cookie.match(/(?:^|;\s*)hubspotutk=([^;]+)/)?.[1];
      const payload = {
        fields: [{ objectTypeId: '0-1', name: 'email', value: email.value.trim() }],
        context: {
          pageUri: window.location.href,
          pageName: document.title,
          ...(hutk ? { hutk } : {}),
        },
      };

      setState(form, 'sending');
      try {
        const response = await fetch(`https://api.hsforms.com/submissions/v3/integration/submit/${portal}/${formId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        setState(form, 'sent');
        email.value = '';
        showStatus(form, form.dataset.success || 'Thanks, you are on the list.');
      } catch {
        setState(form, 'error');
        showStatus(form, form.dataset.error || 'That did not go through.', fallbackFor(form));
      }
    });
  };

  /* Hero film: browsers pause muted autoplay while the tab is hidden; nudge
     it back when the page is visible again. Reduced motion hides it in CSS. */
  const initHeroVideo = (root: HTMLElement) => {
    const video = root.querySelector<HTMLVideoElement>('[data-home2-hero-video]');
    if (!video) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
      return;
    }
    const resume = () => {
      if (document.visibilityState === 'visible' && video.paused) video.play().catch(() => {});
    };
    document.addEventListener('visibilitychange', resume);
    resume();
  };

  const initHomepage = () => {
    document.querySelectorAll<HTMLElement>('[data-home2]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      initHeroVideo(root);
      initRoas(root);
      initContact(root);
      initBrief(root);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHomepage, { once: true });
  } else {
    initHomepage();
  }
  document.addEventListener('astro:page-load', initHomepage);
</script>

---
/*
  Homepage built on the October 2026 review decisions: hero, numbers band,
  practices, The Found Loop, AI inside the Loop, Work (logos, the 46% case
  story with its motion graphic, the client quote), How we engage, the team,
  Research (The Found Brief + Found Signals), partnerships & recognition and
  the contact form. Copy lives in src/lib/homeV2Data.ts; logos, testimonial,
  headline numbers and the team image come from the Sanity `homePage` doc.
*/
import '../../styles/homepage-v2.css';
import { mergeHomePageData, type HomePageData } from '../../lib/homePageData';
import {
  buildRoasDots,
  formatMetric,
  homeV2Forms,
  mergeHomeV2Content,
  selectClientLogos,
  selectPartnerLogos,
  type HomeV2SanityDoc,
  type HomeV2Signal,
} from '../../lib/homeV2Data';

interface Props {
  data?: (Partial<HomePageData> & HomeV2SanityDoc) | null;
  /** Published Found Signals, newest first. Falls back to the approved drafts when empty. */
  signals?: HomeV2Signal[];
}

const { data = null, signals = [] } = Astro.props;
const sanity = mergeHomePageData(data);
// Section copy: the Sanity homePage document over the code defaults, field by field.
const content = mergeHomeV2Content(data);

const clientLogos = selectClientLogos(sanity.clientLogos.logos);
const partnerLogos = selectPartnerLogos(sanity.partners.logos);
const testimonial = sanity.metrics.testimonial;
const testimonialRole = [testimonial.authorTitle, testimonial.authorCompany].filter(Boolean).join(', ');
const teamImage = content.team.imageUrl || sanity.intro.image;
const signalItems = signals.length > 0 ? signals : content.research.signals.drafts;
const roasDots = buildRoasDots(11);
const heroVideo = content.hero.videoUrl.trim();

const proof = [
  { icon: 'chart', value: formatMetric(sanity.metrics.spend), label: content.proof.spendLabel },
  { icon: 'people', value: formatMetric(sanity.metrics.leads), label: content.proof.leadsLabel },
  { icon: 'clock', value: formatMetric(sanity.metrics.experience), label: content.proof.experienceLabel },
];
---

<div class="home2" data-home2>
  <section class="home2-hero" aria-labelledby="home2-hero-title">
    <div class="home2-shell home2-hero__inner">
      <p class="home2-eyebrow">{content.hero.eyebrow}</p>
      <div class="home2-hero__grid">
        <div class="home2-hero__copy">
          <h1 id="home2-hero-title">
            {content.hero.headlineLines.map((line, index) => (
              <Fragment>
                {line}
                {index < content.hero.headlineLines.length - 1 && <br />}
              </Fragment>
            ))}
          </h1>
          <p class="home2-hero__body">{content.hero.body}</p>
          <div class="home2-hero__actions">
            <a class="btn btn--primary" href={content.hero.cta.href}>{content.hero.cta.label}</a>
          </div>
        </div>
        <div class="home2-hero__media">
          {heroVideo ? (
            <div class="home2-video home2-video--live">
              <video
                src={heroVideo}
                poster={content.hero.videoPoster || undefined}
                aria-label={content.hero.videoLabel}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                data-home2-hero-video
              ></video>
              {content.hero.videoPoster && (
                <img class="home2-video__poster" src={content.hero.videoPoster} alt={content.hero.videoLabel} width="1280" height="720" loading="eager" />
              )}
            </div>
          ) : (
            <Fragment>
              <div class="home2-video" aria-hidden="true">
                <span class="home2-video__play">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                </span>
                <span class="home2-video__label">{content.hero.placeholderLabel}</span>
              </div>
              <p class="home2-hero__note">{content.hero.placeholderNote}</p>
            </Fragment>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="home2-proof" aria-label="FoundSM at a glance">
    <div class="home2-shell home2-proof__inner">
      {proof.map((item) => (
        <div class="home2-proof__item">
          <span class="home2-proof__icon" aria-hidden="true">
            {item.icon === 'chart' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16" /><path d="M6 15l4-5 4 3 5-7" /></svg>
            )}
            {item.icon === 'people' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 19c0-3.3 2.9-5.5 6.5-5.5s6.5 2.2 6.5 5.5" /><path d="M16 5a3 3 0 0 1 0 6" /><path d="M18 13.5c2.2.6 3.5 2.3 3.5 4.5" /></svg>
            )}
            {item.icon === 'clock' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3.5 2" /></svg>
            )}
          </span>
          <div>
            <p class="home2-display home2-proof__value">{item.value}</p>
            <p class="home2-proof__label">{item.label}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="home2-section home2-practices" id="practices" aria-labelledby="home2-practices-title">
    <div class="home2-shell home2-practices__inner">
      <div class="home2-head">
        <p class="home2-eyebrow">{content.practices.eyebrow}</p>
        <h2 id="home2-practices-title">{content.practices.heading}</h2>
        <p>{content.practices.intro}</p>
      </div>
      <div class="home2-practices__grid">
        {content.practices.items.map((practice) => (
          <a class="home2-card" href={practice.cta.href}>
            <img
              src={practice.image.src}
              alt={practice.image.alt}
              width={practice.image.width}
              height={practice.image.height}
              style={practice.image.position ? `object-position: ${practice.image.position}` : undefined}
              loading="lazy"
            />
            <div class="home2-card__body">
              <h3 class="home2-card__title">{practice.title}</h3>
              <p class="home2-card__text">{practice.body}</p>
              <span class="home2-more">{practice.cta.label}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home2-section home2-section--paper home2-loop" id="loop" aria-labelledby="home2-loop-title">
    <div class="home2-shell home2-loop__inner">
      <div class="home2-loop__head">
        <div class="home2-head">
          <p class="home2-eyebrow">{content.loop.eyebrow}</p>
          <h2 id="home2-loop-title">{content.loop.heading}</h2>
          <p>{content.loop.intro}</p>
        </div>
        {content.loop.strapline && <p class="home2-loop__strapline">{content.loop.strapline}</p>}
      </div>
      <ol class="home2-loop__stages">
        {content.loop.stages.map((stage) => (
          <li class="home2-stage">
            <span class="home2-display home2-stage__number" aria-hidden="true">{stage.number}</span>
            <h3>{stage.title}</h3>
            <p>{stage.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home2-section home2-section--dark home2-ai" id="ai" aria-labelledby="home2-ai-title">
    <div class="home2-shell home2-ai__inner">
      <div class="home2-ai__head">
        <div class="home2-head">
          <p class="home2-eyebrow home2-eyebrow--light">{content.ai.eyebrow}</p>
          <h2 id="home2-ai-title">{content.ai.heading}</h2>
        </div>
        <p class="home2-ai__intro">{content.ai.intro}</p>
      </div>
      <div class="home2-ai__columns">
        {content.ai.columns.map((column) => (
          <div class="home2-ai__col">
            <h3>{column.title}</h3>
            <p>{column.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="home2-section home2-work" id="work" aria-labelledby="home2-work-title">
    <div class="home2-shell home2-work__inner">
      {clientLogos.length > 0 && (
        <div class="home2-logos">
          <h2 id="home2-logos-title">{content.work.logosHeading}</h2>
          <div class="home2-marquee" aria-label="Client logos">
            <div class="home2-marquee__track">
              {[...clientLogos, ...clientLogos].map((logo, index) => (
                <figure class="home2-marquee__item" aria-hidden={index >= clientLogos.length ? 'true' : undefined}>
                  <img src={logo.src} alt={index >= clientLogos.length ? '' : logo.alt} width={logo.width} height={logo.height} loading="lazy" />
                </figure>
              ))}
            </div>
          </div>
        </div>
      )}

      <div class="home2-case">
        <a class="home2-case__story" href={content.work.cta.href}>
          <div class="home2-case__copy">
            <p class="home2-eyebrow">{content.work.eyebrow}</p>
            <h2 id="home2-work-title">{content.work.heading}</h2>
            <p>{content.work.body}</p>
            <span class="home2-more">{content.work.cta.label}</span>
          </div>
          <div class="home2-case__visual">
            <div class="rx" data-home2-roas aria-hidden="true">
              <div class="rx-stage">
                <span class="rx-eyebrow">{content.work.chart.eyebrow}</span>
                <span class="rx-key">{content.work.chart.key}</span>
                <span class="rx-axis"></span>
                <span class="rx-ceil"></span>
                {roasDots.map((dot) => (
                  <span class={dot.className} style={dot.style}></span>
                ))}
                <span class="rx-bracket"></span>
                <span class="rx-num">+<span class="rx-count"></span>%</span>
                <span class="rx-lbl rx-lbl--0">{content.work.chart.startLabel}</span>
                <span class="rx-lbl rx-lbl--60">{content.work.chart.endLabel}</span>
              </div>

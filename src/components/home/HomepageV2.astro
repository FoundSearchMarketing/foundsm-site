          </div>
        </a>

        {testimonial.quote && (
          <figure class="home2-quote">
            <span class="home2-quote__disc" aria-hidden="true"></span>
            <span class="home2-quote__ring" aria-hidden="true"></span>
            <span class="home2-quote__mark" aria-hidden="true">&ldquo;</span>
            <blockquote>&ldquo;{testimonial.quote}&rdquo;</blockquote>
            <figcaption>
              {testimonial.authorName && <strong>{testimonial.authorName}</strong>}

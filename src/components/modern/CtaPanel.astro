---
interface Props {
  title?: string;
  body?: string | string[];
  bodyHtml?: string;
  ctaLabel?: string;
  ctaHref?: string;
  theme?: 'dark' | 'green' | 'light' | 'white';
  align?: 'split' | 'centered';
  layoutPreset?: 'panel' | 'strip' | 'compact';
}

const { title, body, bodyHtml, ctaLabel, ctaHref, theme = 'dark', align = 'split', layoutPreset = 'panel' } = Astro.props;
const paragraphs = Array.isArray(body) ? body : body ? [body] : [];
const buttonOnly = !title && paragraphs.length === 0 && !bodyHtml;
// theme="green" / theme="dark" opt into the canonical band treatments in
// global.css: green or dark field under the same street-map artwork, bold
// headline, regular-weight body copy.
const bandClass = theme === 'green' ? 'green-band' : theme === 'dark' ? 'dark-band' : '';
const classes = ['modern-cta', `modern-cta--${theme}`, `modern-cta--${align}`, `modern-cta--${layoutPreset}`, bandClass, buttonOnly ? 'modern-cta--button-only' : ''].filter(Boolean).join(' ');
const bodyClasses = ['modern-cta__body', bandClass ? `${bandClass}__body` : ''].filter(Boolean).join(' ');
const buttonVariant = theme === 'green' || theme === 'light' ? 'btn--dark' : 'btn--primary';
const buttonSize = buttonOnly ? ' btn--lg' : '';
---

<section class={classes} aria-label={title ?? ctaLabel ?? 'Call to action'}>
  <div class="modern-cta__inner">
    <div class="modern-cta__copy">
      {title && <h2>{title}</h2>}
      {bodyHtml ? (
        <div class={bodyClasses} set:html={bodyHtml} />
      ) : paragraphs.length > 0 && (
        <div class={bodyClasses}>
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      )}
    </div>
    {ctaLabel && ctaHref && <a class={`btn ${buttonVariant}${buttonSize} modern-cta__button`} href={ctaHref}>{ctaLabel}</a>}
  </div>
</section>

<style>
  .modern-cta {
    padding: 4rem var(--gutter);
  }

  .modern-cta--strip {
    padding-block: 2rem;
  }

  .modern-cta--compact {
    padding-block: 3rem;
  }

  .modern-cta--button-only {
    margin-block-start: -2rem;
    padding-block: 0 4rem;
    text-align: left;
  }

  .modern-cta--button-only .modern-cta__inner {
    display: block;
  }

  /* Field, texture and type come from .green-band in global.css. */
  .modern-cta--green {
    padding-block: 1rem;
  }

  .modern-cta--light {
    background: #f2f3f2;
    color: #1a1a1a;
  }

  .modern-cta--white {
    background: #ffffff;
    color: #231f20;
  }

  .modern-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
    inline-size: min(100%, var(--content-max-width));
    margin-inline: auto;
  }

  .modern-cta--panel .modern-cta__inner {
    padding: 2.5rem;
    border-radius: 0.5rem;
  }

  .modern-cta--light.modern-cta--panel .modern-cta__inner,
  .modern-cta--white.modern-cta--panel .modern-cta__inner {
    background: rgba(26, 26, 26, 0.04);
  }

  .modern-cta--centered {
    padding-block: 6.25rem;
  }

  .modern-cta--centered .modern-cta__inner {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
  }

  .modern-cta__copy {
    display: grid;
    gap: 0.85rem;
    max-inline-size: 64rem;
  }

  .modern-cta h2 {
    margin: 0;
    color: inherit;
    font-size: 2.35rem;
    line-height: 1.16;
    letter-spacing: 0;
  }

  .modern-cta--centered h2 {
    font-size: 3.75rem;
    font-weight: 900;
    line-height: 0.95;
  }

  .modern-cta__body {
    display: grid;
    gap: 0.6rem;
    color: currentColor;
    font-size: 1.08rem;
    line-height: 1.7;
    opacity: 0.84;
  }

  .modern-cta--centered .modern-cta__body {
    max-inline-size: 67rem;
  }

  .modern-cta__button {
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .modern-cta__inner {
      grid-template-columns: 1fr;
    }

    .modern-cta--panel .modern-cta__inner {
      padding: 1.5rem;
    }

    .modern-cta h2 {
      font-size: 2rem;
    }

    .modern-cta--centered {
      padding-block: 3.125rem;
    }

    .modern-cta--centered h2 {
      font-size: 2.125rem;
      line-height: 1.147;
    }

    .modern-cta__button {
      justify-self: start;
      white-space: normal;
    }

    .modern-cta--centered .modern-cta__button {
      justify-self: center;
    }
  }
</style>

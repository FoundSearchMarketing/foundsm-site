---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string | string[];
  introHtml?: string;
  lead?: string;
  formId: string;
  portalId?: string;
  /** ActiveCampaign form id. When set, the AC embed replaces the HubSpot frame. */
  acFormId?: string;
  summary?: string;
  summaryHtml?: string;
  variant?: 'contact' | 'newsletter' | 'dataconnect' | 'resource' | 'event';
  theme?: 'light' | 'dark' | 'muted';
  loadFormScript?: boolean;
  showFormCard?: boolean;
}

const {
  eyebrow,
  title,
  intro,
  introHtml,
  lead,
  formId,
  portalId = '5045186',
  acFormId,
  summary,
  summaryHtml,
  variant = 'contact',
  theme = variant === 'newsletter' ? 'light' : 'dark',
  loadFormScript = true,
  showFormCard = true,
} = Astro.props;
const introParagraphs = Array.isArray(intro) ? intro : [intro];
const sectionId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
---

<section id={sectionId} class:list={['form-landing', `form-landing--${variant}`, `form-landing--theme-${theme}`, { 'form-landing--loads-form': loadFormScript }]} aria-labelledby={`${variant}-form-heading`}>
  <div class="form-landing__inner">
    <div class="form-landing__copy">
      {eyebrow && <p class="form-landing__eyebrow">{eyebrow}</p>}
      <h1 id={`${variant}-form-heading`}>{title}</h1>
      {lead && <p class="form-landing__lead"><strong>{lead}</strong></p>}
      {introHtml ? <div class="form-landing__intro" set:html={introHtml} /> : introParagraphs.map((item) => <p>{item}</p>)}
    </div>

    <div class:list={['form-landing__form-card', { 'form-landing__form-card--bare': !showFormCard }]}>
      {acFormId ? (
        <div class={`_form_${acFormId} form-landing__frame`} id="form-landing-ac"></div>
      ) : loadFormScript ? (
        <div class="hs-form-frame form-landing__frame" data-region="na1" data-form-id={formId} data-portal-id={portalId}></div>
      ) : (
        <div class="form-landing__frame form-landing__frame--placeholder" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
      )}
    </div>
  </div>
</section>

{(summary || summaryHtml) && (
  <section class={`form-landing-summary form-landing-summary--${variant}`}>
    <div class="form-landing-summary__inner">
      {summaryHtml ? <div set:html={summaryHtml} /> : <p>{summary}</p>}
    </div>
  </section>
)}

{acFormId ? (
  <>
    <script is:inline src={`https://foundsm.activehosted.com/f/embed.php?id=${acFormId}`} charset="utf-8" defer></script>
    <script is:inline>
      // The HubSpot original shipped the marketing opt-in pre-checked; AC forms
      // cannot default a checkbox, so tick it once the embed renders.
      (function precheckOptIn(tries) {
        var box = document.querySelector('#form-landing-ac input[type="checkbox"]');
        if (box) {
          box.checked = true;
          // AC renders the dropdown's first option blank; restore the prompt.
          var sel = document.querySelector('#form-landing-ac select');
          if (sel && sel.options.length && !sel.options[0].text.trim()) {
            sel.options[0].text = 'Select option...';
          }
          return;
        }
        if (tries < 40) setTimeout(function () { precheckOptIn(tries + 1); }, 300);
      })(0);
    </script>
  </>
) : loadFormScript && (
  <script is:inline src="https://js.hsforms.net/forms/embed/5045186.js" defer></script>
)}

<style>
  .form-landing {
    position: relative;
    overflow: hidden;
    padding-block: var(--split-hero-padding-block);
    padding-inline: var(--gutter);
    background: #f2f3f2;
  }

  .form-landing--theme-light {
    background: #ffffff;
    color: #231f20;
  }

  .form-landing--theme-muted,
  .form-landing--resource {
    background: #f2f3f2;
    color: #231f20;
  }

  .form-landing--theme-dark,
  .form-landing--event {
    background-color: #231f20;
    color: #ffffff;
  }

  .form-landing--contact {
    min-block-size: 56.25rem;
    padding-block: var(--split-hero-padding-block-start) 0;
    padding-inline: 1.5625rem;
    background-color: #231f20;
    background-image: url("/images/pages/our-approach/contact-bg-fc.svg");
    background-repeat: no-repeat;
    background-size: cover;
    color: #ffffff;
  }

  .form-landing--event {
    min-block-size: 0;
    padding-block: var(--split-hero-padding-block);
    padding-inline: 1.5625rem;
    background-image:
      linear-gradient(rgba(35, 31, 32, 0.88), rgba(35, 31, 32, 0.88)),
      url("/images/pages/performance-creative/map.png");
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  .form-landing--resource {
    min-block-size: 0;
    padding-block: var(--split-hero-padding-block);
    padding-inline: 1.5625rem;
  }

  .form-landing--dataconnect {
    min-block-size: 30.1875rem;
    padding: 0 1.5625rem;
    background-color: #231f20;
    background-image:
      linear-gradient(rgba(35, 31, 32, 0.9), rgba(35, 31, 32, 0.9)),
      url("/images/pages/performance-creative/map.png");
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    color: #ffffff;
  }

  .form-landing__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr);
    align-items: start;
    gap: 3rem;
    inline-size: min(100%, var(--content-max-width));
    margin-inline: auto;
  }

  .form-landing--contact .form-landing__inner {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .form-landing__copy {
    display: grid;
    gap: 1rem;
    padding-block-start: var(--split-hero-copy-padding-block-start);
  }

  .form-landing--dataconnect .form-landing__inner {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: flex-start;
    gap: 1.25rem;
    inline-size: min(100%, 87.5rem);
    padding-block-start: 3.125rem;
  }

  .form-landing--dataconnect .form-landing__copy {
    gap: 1.25rem;
    padding: 0.625rem;
  }

  .form-landing__eyebrow {
    color: inherit;
    font-size: 1.125rem;
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .form-landing h1 {
    max-inline-size: 42rem;
    margin: 0;
    font-size: 4.375rem;
    line-height: 1.071;
    letter-spacing: 0;
  }

  .form-landing--theme-dark h1,
  .form-landing--contact h1,
  .form-landing--dataconnect h1 {
    color: #ffffff;
  }

  .form-landing--contact .form-landing__copy {
    padding-block-start: 0;
  }

  .form-landing--dataconnect h1 {
    max-inline-size: none;
    font-size: 4.375rem;
    font-weight: 900;
    line-height: 1.071;
    margin-block-end: 1.25rem;
  }

  .form-landing__copy > p:not(.form-landing__eyebrow),
  .form-landing__intro {
    max-inline-size: 40rem;
    color: rgba(26, 26, 26, 0.78);
    font-size: 1.25rem;
    line-height: 1.8;
  }

  .form-landing__intro :global(p + p) {
    margin-top: 1rem;
  }

  .form-landing__lead {
    margin-block-end: -0.25rem;
  }

  .form-landing--dataconnect .form-landing__lead {
    margin: 0;
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.8;
  }

  .form-landing--theme-dark .form-landing__copy > p:not(.form-landing__eyebrow),
  .form-landing--theme-dark .form-landing__intro,
  .form-landing--contact .form-landing__copy > p:not(.form-landing__eyebrow),
  .form-landing--contact .form-landing__intro,
  .form-landing--dataconnect .form-landing__copy > p:not(.form-landing__eyebrow),
  .form-landing--dataconnect .form-landing__intro {
    color: #ffffff;
  }

  .form-landing--dataconnect .form-landing__copy > p:not(.form-landing__eyebrow),
  .form-landing--dataconnect .form-landing__intro {
    max-inline-size: none;
    font-size: 1.25rem;
    line-height: 1.8;
  }

  .form-landing__form-card {
    min-block-size: 28rem;
    padding: 1.5rem;
    border: 1px solid rgba(26, 26, 26, 0.12);
    border-radius: 2.5rem;
    background: #ffffff;
    box-shadow: 0 18px 42px rgba(26, 26, 26, 0.08);
  }

  .form-landing--contact .form-landing__form-card {
    min-block-size: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .form-landing__form-card--bare {
    min-block-size: 0;
    padding: 0.625rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  /* ActiveCampaign embed on the contact hero: match the HubSpot form it
     replaces — white labels over white rounded inputs on the dark band,
     First/Last side by side, canonical green pill submit. Scoped under an
     owned id because the embed ships #_form_<hash>_ !important rules and
     that hash changes between embed builds. */
  #form-landing-ac :global(form._form_8) {
    inline-size: 100% !important;
    max-inline-size: none !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    font-family: var(--font-body) !important;
  }

  #form-landing-ac :global(._form_8 ._form-title),
  #form-landing-ac :global(._form_8 ._form-branding) {
    display: none !important;
  }

  #form-landing-ac :global(._form_8 ._form-content) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1rem;
  }

  #form-landing-ac :global(._form_8 ._form_element),
  #form-landing-ac :global(._form_8 ._button-wrapper) {
    inline-size: 100%;
    margin: 0 !important;
  }

  #form-landing-ac :global(._form_8 ._form_element:has(input[name='firstname'])),
  #form-landing-ac :global(._form_8 ._form_element:has(input[name='lastname'])) {
    inline-size: calc(50% - 0.5rem);
  }

  #form-landing-ac :global(._form_8 ._form-label),
  #form-landing-ac :global(._form_8 ._form_element label) {
    display: block !important;
    margin-block-end: 0.35rem !important;
    color: #ffffff !important;
    font-family: var(--font-body) !important;
    font-size: 0.8rem !important;
    font-weight: 400 !important;
  }

  #form-landing-ac :global(._form_8 input[type='text']),
  #form-landing-ac :global(._form_8 input[type='email']),
  #form-landing-ac :global(._form_8 input[type='tel']),
  #form-landing-ac :global(._form_8 select),
  #form-landing-ac :global(._form_8 textarea) {
    inline-size: 100% !important;
    padding: 0.7rem 0.9rem !important;
    border: 0 !important;
    border-radius: 0.5rem !important;
    background: #ffffff !important;
    color: #142341 !important;
    font-family: var(--font-body) !important;
    font-size: 0.9rem !important;
  }

  #form-landing-ac :global(._form_8 textarea) {
    min-block-size: 6rem !important;
    resize: vertical;
  }

  #form-landing-ac :global(._form_8 ._field_html p) {
    margin: 0.4rem 0 0 !important;
    color: #ffffff !important;
    font-size: 0.75rem !important;
    line-height: 1.5 !important;
  }

  /* The checkbox field renders its title as a legend AND its option as a
     label; the HubSpot original showed only the option, inline with the box. */
  #form-landing-ac :global(._form_8 ._form-fieldset ._form-label) {
    display: none !important;
  }

  #form-landing-ac :global(._form_8 ._form-fieldset) {
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
  }

  #form-landing-ac :global(._form_8 ._checkbox-radio) {
    display: flex !important;
    align-items: center;
    gap: 0.5rem;
  }

  #form-landing-ac :global(._form_8 ._checkbox-radio input[type='checkbox']) {
    inline-size: auto !important;
    margin: 0 !important;
    accent-color: var(--color-primary);
  }

  #form-landing-ac :global(._form_8 ._checkbox-radio label) {
    margin: 0 !important;
  }

  #form-landing-ac :global(._form_8 ._submit) {
    inline-size: auto;
    min-block-size: 3.25rem;
    margin-block-start: 0.4rem !important;
    padding: 0.9rem 1.75rem !important;
    border: 0 !important;
    border-radius: var(--radius-pill) !important;
    background: var(--color-primary) !important;
    color: var(--color-dark) !important;
    font-family: var(--font-body) !important;
    font-size: var(--text-btn) !important;
    font-weight: 500 !important;
    line-height: 1.2 !important;
    cursor: pointer;
  }

  #form-landing-ac :global(._form_8 ._submit:hover) {
    background: var(--color-primary-hover) !important;
  }

  #form-landing-ac :global(._form_8 ._form-thank-you) {
    color: #ffffff !important;
    font-family: var(--font-body) !important;
  }

  .form-landing__frame {
    min-block-size: 25rem;
  }

  .form-landing__frame--placeholder {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1rem;
    border-radius: 1rem;
    background: #f2f3f2;
  }

  .form-landing__frame--placeholder span {
    display: block;
    block-size: 3.2rem;
    border-radius: 0.5rem;
    background: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(26, 26, 26, 0.08);
  }

  .form-landing__frame--placeholder span:last-child {
    inline-size: min(100%, 12rem);
    background: var(--color-primary);
  }

  .form-landing--contact .form-landing__frame,
  .form-landing__form-card--bare .form-landing__frame {
    min-block-size: 0;
  }

  .form-landing-summary {
    padding: 3rem var(--gutter);
    background: #1a1a1a;
    color: #ffffff;
  }

  .form-landing-summary--contact {
    padding: 7.5rem 1.5625rem 0;
    margin-block-end: 6.25rem;
    background: #ffffff;
    color: #231f20;
  }

  .form-landing-summary--dataconnect {
    margin-block-end: 6.25rem;
    padding-block: 6.25rem 1.25rem;
    background: #ffffff;
    color: #231f20;
  }

  .form-landing-summary__inner {
    inline-size: min(100%, 64rem);
    margin-inline: auto;
    text-align: center;
  }

  .form-landing-summary :global(p) {
    font-size: 1.25rem;
    line-height: 1.8;
  }

  .form-landing-summary--dataconnect .form-landing-summary__inner {
    inline-size: min(100%, 62.5rem);
  }

  .form-landing-summary--dataconnect :global(p) {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.8;
    text-align: center;
  }

  :global(.form-landing__frame iframe) {
    inline-size: 100%;
  }

  @media (min-width: 901px) {
    .form-landing--contact .form-landing__copy {
      gap: 2.5rem;
      padding: 0.625rem;
    }

    .form-landing--contact .form-landing__intro {
      max-inline-size: none;
      padding-block: 0.625rem;
    }

    .form-landing--contact .form-landing__form-card {
      padding: 0.625rem;
    }
  }

  @media (min-width: 1025px) {
    .form-landing--contact .form-landing__inner {
      inline-size: var(--split-hero-content-width);
    }

    .form-landing--contact .form-landing__copy {
      padding-block-start: var(--split-hero-copy-padding-block-start);
      padding-inline: var(--split-hero-copy-padding-inline-start) 0;
    }

    .form-landing--contact h1,
    .form-landing--newsletter h1 {
      max-inline-size: var(--split-hero-copy-max-width);
      font-size: var(--split-hero-title-size);
      line-height: var(--split-hero-title-line-height);
    }

    .form-landing--contact .form-landing__intro {
      max-inline-size: var(--split-hero-body-max-width);
      font-size: var(--split-hero-body-size);
      line-height: var(--split-hero-body-line-height);
    }
  }

  @media (max-width: 900px) {
    .form-landing__inner {
      grid-template-columns: 1fr;
    }

    .form-landing--contact .form-landing__inner {
      grid-template-columns: 1fr;
    }

    .form-landing--dataconnect {
      min-block-size: 26.875rem;
      padding-inline: 1.25rem;
    }

    .form-landing--dataconnect .form-landing__inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-block-start: 1.25rem;
    }

    .form-landing--dataconnect .form-landing__copy {
      gap: 0;
      margin-block-end: -1.25rem;
      padding: 0.625rem;
    }

    .form-landing__copy {
      padding-block-start: 0;
    }

    .form-landing h1 {
      font-size: 2.8125rem;
      line-height: 1.111;
    }

    .form-landing--dataconnect h1 {
      font-size: 2.8125rem;
      line-height: 1.111;
    }

    .form-landing-summary--dataconnect {
      margin-block: 2.5rem;
      padding: 3.125rem 1.5625rem 4.125rem;
    }

    .form-landing-summary--dataconnect :global(p) {
      font-size: 1.125rem;
      line-height: 1.667;
    }

  }

  @media (max-width: 640px) {
    .form-landing--contact {
      min-block-size: 85.625rem;
      padding-block: var(--split-hero-padding-block-start) 0;
      padding-inline: 1.25rem;
    }

    .form-landing--dataconnect {
      block-size: 26.875rem;
      min-block-size: 0;
      padding-block: 0;
    }

    .form-landing--dataconnect.form-landing--loads-form {
      block-size: auto;
      min-block-size: 26.875rem;
      overflow: visible;
      padding-block-end: 2rem;
    }

    .form-landing h1 {
      font-size: 2.375rem;
      line-height: 1.105;
    }

    .form-landing--contact h1 {
      font-size: 2.8125rem;
      line-height: 1.111;
    }

    .form-landing--contact .form-landing__intro {
      font-size: 1.125rem;
      line-height: 1.666;
    }

    .form-landing--dataconnect h1 {
      font-size: 2.8125rem;
      line-height: 1.111;
      margin-block-end: 0;
    }

    .form-landing--dataconnect .form-landing__lead,
    .form-landing--dataconnect .form-landing__copy > p:not(.form-landing__eyebrow) {
      font-size: 1.125rem;
      line-height: 1.667;
    }


    .form-landing__form-card {
      padding: 1rem;
      border-radius: 1.875rem;
    }

    .form-landing--contact .form-landing__form-card {
      padding: 0;
      border-radius: 0;
    }

    .form-landing--contact + .form-landing-summary {
      padding: 3.75rem 1.5625rem;
      margin-block: 2.5rem;
    }

    :global(.form-landing--contact + .form-landing-summary p) {
      font-size: 1.125rem;
      line-height: 1.666;
    }

    .form-landing--dataconnect .form-landing__form-card--bare {
      padding: 1.25rem 0 0;
    }
  }
</style>

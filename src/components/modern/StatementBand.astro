---
interface Props {
  lead: string;
  body: string | string[];
  bodyHtml?: string;
  theme?: 'dark' | 'muted' | 'light';
  pattern?: boolean;
  width?: 'default' | 'narrow';
  /** Optional outlined pill under the body. Rendered only when a page passes it. */
  cta?: { label: string; href: string };
}

const { lead, body, bodyHtml, theme = 'dark', pattern = false, width = 'default', cta } = Astro.props;
const paragraphs = Array.isArray(body) ? body : [body];
const bodyClasses = ['statement-band__body', pattern && theme === 'dark' ? 'dark-band__body' : ''].filter(Boolean).join(' ');
// A dark patterned band is the canonical .dark-band treatment in global.css.
const classes = [
  'statement-band',
  `statement-band--${theme}`,
  pattern ? 'statement-band--pattern' : '',
  pattern && theme === 'dark' ? 'dark-band' : '',
  width === 'narrow' ? 'statement-band--narrow' : '',
].filter(Boolean).join(' ');
---

<section class={classes}>
  <div class="statement-band__inner">
    <p class="statement-band__lead">{lead}</p>
    {cta ? (
      <div class="statement-band__aside">
        {bodyHtml ? (
          <div class={bodyClasses} set:html={bodyHtml} />
        ) : (
          <div class={bodyClasses}>
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        )}
        <a class="btn btn--secondary-white statement-band__button" href={cta.href}>{cta.label}</a>
      </div>
    ) : bodyHtml ? (
      <div class={bodyClasses} set:html={bodyHtml} />
    ) : (
      <div class={bodyClasses}>
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    )}
  </div>
</section>

<style>
  .statement-band {
    position: relative;
    overflow: hidden;
    padding: 4rem var(--gutter);
  }

  /* A patterned dark band takes its field and artwork from .dark-band in
     global.css, so only the unpatterned variant paints its own flat field. */
  .statement-band--dark:not(.dark-band) {
    background: #1a1a1a;
  }

  .statement-band--dark {
    color: #ffffff;
  }

  /* A dark patterned band takes its field and artwork from .dark-band. */
  .statement-band--pattern:not(.dark-band) {
    background-color: #231f20;
    background-image: url('/images/pages/our-approach/contact-bg-fc.svg');
    background-position: center;
    background-size: cover;
  }

  .statement-band--muted {
    background: #f2f3f2;
  }

  .statement-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 3rem;
    inline-size: min(100%, var(--content-max-width));
    margin-inline: auto;
  }

  .statement-band--narrow .statement-band__inner {
    inline-size: min(100%, 70rem);
  }

  .statement-band__lead {
    font-family: var(--font-body);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.286;
  }

  .statement-band__body {
    display: grid;
    gap: 0.8rem;
    color: currentColor;
    font-size: 1rem;
    line-height: 1.875;
  }

  /* The shared dark-band body rule fades copy to 82%. These three bands
     (Capabilities, AI, Team) need the paragraph at full white. */
  .statement-band--dark .statement-band__body,
  .statement-band--dark .statement-band__body p {
    color: #ffffff;
    opacity: 1;
  }

  .statement-band__aside {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
  }

  /* Compact white outline. The site's dark-band outline button is the base;
     size is tightened here so the band stays near its text-only height.
     Only rendered when a page passes a cta. */
  .statement-band a.statement-band__button {
    justify-self: start;
    min-block-size: 0;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    background: transparent;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px #fff;
  }

  .statement-band a.statement-band__button:hover,
  .statement-band a.statement-band__button:focus-visible {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    box-shadow: inset 0 0 0 1px #fff;
  }

  @media (max-width: 800px) {
    .statement-band__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .statement-band--narrow {
      text-align: center;
    }

    .statement-band__lead {
      font-size: 1.125rem;
      line-height: 1.778;
    }
  }
</style>

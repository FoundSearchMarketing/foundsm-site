---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaAsset from '../../components/MediaAsset.astro';
import AiLoopBand from '../../components/AiLoopBand.astro';
import { capabilitiesPageQuery, sanityClient } from '../../lib/sanity';
import { defaultCapabilitiesPageData, mergeCapabilitiesPageData } from '../../lib/fixedPageData';
import { imageProps, richHtml } from '../../lib/fixedPageRender';

const sanityPage = await sanityClient.fetch(capabilitiesPageQuery).catch(() => null);
const page = mergeCapabilitiesPageData(sanityPage);
const title = page.seoTitle || defaultCapabilitiesPageData.seoTitle;
const description = page.seoDescription || defaultCapabilitiesPageData.seoDescription;
const canonical = page.canonicalUrl || defaultCapabilitiesPageData.canonicalUrl;
const robots = page.robots || defaultCapabilitiesPageData.robots;
const dataDetail = page.details[0];
const paidDetail = page.details[1];
const creativeDetail = page.details[2];
const imageLoading = (loading: 'eager' | 'lazy' = 'lazy') => loading;

const heroMedia = imageProps(page.hero, 'eager');
const outcomesMedia = imageProps(page.outcomes);
const workflowMedia = imageProps(page.workflow);
const dataMedia = imageProps(dataDetail);
const paidMedia = imageProps(paidDetail);
const creativeMedia = imageProps(creativeDetail);
const heroImageAlt = page.hero.imageAlt || '';
const outcomesImageAlt = page.outcomes.imageAlt || '';
const workflowImageAlt = page.workflow.imageAlt || '';
const dataImageAlt = dataDetail?.imageAlt || '';
const paidImageAlt = paidDetail?.imageAlt || '';
const creativeImageAlt = creativeDetail?.imageAlt || '';
const ai = page.ai;
const aiColumns = ai.columns
  .filter((column) => column.title && column.body)
  .map((column) => ({ title: column.title as string, body: column.body as string }));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: canonical,
  description,
  publisher: {
    '@type': 'Organization',
    name: 'Found Search Marketing',
    url: 'https://foundsm.com',
    logo: 'https://foundsm.com/images/logo.svg'
  }
};
---

<BaseLayout title={title} description={description} canonical={canonical} robots={robots} schema={schema} bodyClass="site-2026">
  <div class="capabilities-page">
    <section class="capabilities-hero" aria-labelledby="capabilities-hero-title">
      <div class:list={['capabilities-hero__inner', { 'capabilities-hero__inner--text-only': !heroMedia }]}>
        <div class="capabilities-hero__copy">
          <h1 id="capabilities-hero-title" class="capabilities-hero__title">{page.hero.heading}</h1>
          <div class="capabilities-hero__text" set:html={richHtml(page.hero.body)} />
        </div>

        {heroMedia && (
          <div class="capabilities-hero__media" aria-hidden={heroImageAlt ? undefined : 'true'}>
            <MediaAsset
              class="capabilities-hero__image"
              src={heroMedia.src}
              width="900"
              height="600"
              alt={heroImageAlt}
              loading="eager"
            />
          </div>
        )}
      </div>
    </section>

    <section class="outcomes-section" aria-labelledby="outcomes-title">
      <div class="outcomes-section__heading">
        {page.outcomes.eyebrow && <p class="eyebrow-2026">{page.outcomes.eyebrow}</p>}
        <h2 id="outcomes-title" class="outcomes-section__title">{page.outcomes.heading}</h2>
      </div>

      <div class:list={['outcomes-section__inner', { 'outcomes-section__inner--text-only': !outcomesMedia }]}>
        {outcomesMedia && (
          <div class="outcomes-section__media" aria-hidden={outcomesImageAlt ? undefined : 'true'}>
            <MediaAsset
              class="outcomes-section__image"
              src={outcomesMedia.src}
              width="524"
              height="725"
              alt={outcomesImageAlt}
              loading={imageLoading()}
            />
          </div>
        )}

        <div class="outcomes-section__copy" set:html={richHtml(page.outcomes.body)} />
      </div>
    </section>

    <section class="workflow-section" aria-labelledby="workflow-title">
      <div class:list={['workflow-section__inner', { 'workflow-section__inner--text-only': !workflowMedia }]}>
        <div class="workflow-section__copy">
          <h2 id="workflow-title" class="workflow-section__title">{page.workflow.heading}</h2>
          <div class="workflow-section__text" set:html={richHtml(page.workflow.body)} />
          {page.workflow.prompt && <p class="workflow-section__prompt more-2026">{page.workflow.prompt}</p>}
        </div>

        {workflowMedia && (
          <div class="workflow-section__media">
            <MediaAsset
              class="workflow-section__image"
              src={workflowMedia.src}
              width="500"
              height="500"
              alt={workflowImageAlt}
              loading={imageLoading()}
            />
          </div>
        )}
      </div>
    </section>

    <section class="capability-detail capability-detail--data" id="capabilities-data-reporting-analytics" aria-labelledby="capability-data-title">
      <div class:list={['capability-detail__inner', { 'capability-detail__inner--text-only': !dataMedia }]}>
        <div class="capability-detail__copy">
          <h2 id="capability-data-title" class="capability-detail__title">{dataDetail?.heading}</h2>
          <div class="capability-detail__text" set:html={richHtml(dataDetail?.body)} />
          {dataDetail?.cta?.label && dataDetail?.cta?.href && (
            <a class="btn btn--primary capability-detail__button" href={dataDetail.cta.href}>{dataDetail.cta.label}</a>
          )}
        </div>

        {dataMedia && (
          <div class="capability-detail__media" aria-hidden={dataImageAlt ? undefined : 'true'}>
            <MediaAsset
              class="capability-detail__image"
              src={dataMedia.src}
              width="1024"
              height="983"
              alt={dataImageAlt}
              loading={imageLoading()}
            />
          </div>
        )}
      </div>
    </section>

    <section class="capability-detail capability-detail--paid" id="capabilities-paid-media" aria-labelledby="capability-paid-title">
      <div class:list={['capability-detail__inner capability-detail__inner--reverse', { 'capability-detail__inner--text-only': !paidMedia }]}>
        {paidMedia && (
          <div class="capability-detail__media" aria-hidden={paidImageAlt ? undefined : 'true'}>
            <MediaAsset
              class="capability-detail__image"
              src={paidMedia.src}
              width="753"
              height="768"
              alt={paidImageAlt}
              loading={imageLoading()}
            />
          </div>
        )}

        <div class="capability-detail__copy">
          <h2 id="capability-paid-title" class="capability-detail__title">{paidDetail?.heading}</h2>
          <div class="capability-detail__text" set:html={richHtml(paidDetail?.body)} />
          {paidDetail?.cta?.label && paidDetail?.cta?.href && (
            <a class="btn btn--primary capability-detail__button" href={paidDetail.cta.href}>{paidDetail.cta.label}</a>
          )}
        </div>
      </div>
    </section>

    <section class="capability-detail capability-detail--creative" id="capabilities-performance-creative" aria-labelledby="capability-creative-title">
      <div class:list={['capability-detail__inner', { 'capability-detail__inner--text-only': !creativeMedia }]}>
        <div class="capability-detail__copy">
          <h2 id="capability-creative-title" class="capability-detail__title">{creativeDetail?.heading}</h2>
          <div class="capability-detail__text" set:html={richHtml(creativeDetail?.body)} />
          {creativeDetail?.cta?.label && creativeDetail?.cta?.href && (
            <a class="btn btn--primary capability-detail__button" href={creativeDetail.cta.href}>{creativeDetail.cta.label}</a>
          )}
        </div>

        {creativeMedia && (
          <div class="capability-detail__media" aria-hidden={creativeImageAlt ? undefined : 'true'}>
            <MediaAsset
              class="capability-detail__image"
              src={creativeMedia.src}
              width="753"
              height="768"
              alt={creativeImageAlt}
              loading={imageLoading()}
            />
          </div>
        )}
      </div>
    </section>

    {ai.eyebrow && ai.heading && ai.intro && aiColumns.length > 0 && (
      <AiLoopBand id="capabilities-ai" eyebrow={ai.eyebrow} heading={ai.heading} intro={ai.intro} columns={aiColumns} />
    )}
  </div>
</BaseLayout>

<style>
  /* Capabilities page on the 2026 type system: tokens come from site-2026.css. */
  .capabilities-page {
    color: var(--s26-ink);
    background: #ffffff;
    font-family: var(--font-body);
    overflow: hidden;
  }

  .capabilities-page :is(h1, h2) {
    margin: 0;
    color: var(--s26-ink);
  }

  .capabilities-hero {
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(3rem, 6vw, 4rem);
    background: #ffffff;
  }

  .capabilities-hero__inner,
  .outcomes-section__inner,
  .workflow-section__inner,
  .capability-detail__inner {
    inline-size: var(--s26-shell);
    margin-inline: auto;
  }

  .capabilities-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: start;
    gap: 2.5rem 3rem;
  }

  .capabilities-hero__copy {
    display: grid;
    gap: 1.5rem;
  }

  .capabilities-hero__inner--text-only {
    grid-template-columns: minmax(0, 46rem);
  }

  .capabilities-hero__title {
    font-size: var(--s26-size-h1);
    line-height: 0.94;
  }

  .capabilities-hero__text {
    max-width: 36.25rem;
    color: var(--s26-muted);
    font-size: var(--s26-text-lead);
    line-height: var(--s26-lh-body);
  }

  .outcomes-section__copy,
  .workflow-section__text,
  .capability-detail__text {
    color: var(--s26-muted);
    font-size: var(--s26-text-body);
    line-height: var(--s26-lh-body);
  }

  .capabilities-hero__text :global(p),
  .outcomes-section__copy :global(p),
  .workflow-section__text :global(p),
  .capability-detail__text :global(p) {
    margin: 0;
  }

  .capabilities-hero__text :global(p + p),
  .outcomes-section__copy :global(p + p),
  .workflow-section__text :global(p + p),
  .capability-detail__text :global(p + p) {
    margin-top: 1rem;
  }

  .capabilities-hero__media {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--s26-radius);
    --media-asset-radius: var(--s26-radius);
    --media-asset-fit: cover;
  }

  .capabilities-hero__media :global(.capabilities-hero__image) {
    inline-size: 100%;
    aspect-ratio: 3 / 2;
    border-radius: var(--s26-radius);
    object-fit: cover;
  }

  .outcomes-section {
    padding-block: var(--s26-section);
    background: var(--s26-paper);
  }

  .outcomes-section__heading {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    inline-size: var(--s26-shell);
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .outcomes-section__title {
    font-size: var(--s26-size-h2);
    line-height: 1.05;
    text-wrap: balance;
  }

  .outcomes-section__inner {
    display: grid;
    grid-template-columns: minmax(20rem, 37%) minmax(0, 1fr);
    align-items: center;
    gap: 4rem;
  }

  .outcomes-section__inner--text-only {
    grid-template-columns: minmax(0, 52rem);
    justify-content: center;
  }

  .outcomes-section__media {
    --media-asset-radius: var(--s26-radius);
  }

  .outcomes-section__media :global(.outcomes-section__image) {
    inline-size: 100%;
    max-inline-size: 32.75rem;
    border-radius: var(--s26-radius);
  }

  .outcomes-section__copy {
    max-width: 62ch;
  }

  .workflow-section {
    padding-block: var(--s26-section);
    background: #ffffff;
  }

  .workflow-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 38%);
    align-items: center;
    gap: 3rem;
  }

  .workflow-section__inner--text-only {
    grid-template-columns: minmax(0, 54rem);
  }

  .workflow-section__copy {
    display: grid;
    gap: 0.875rem;
    max-width: 62ch;
  }

  .workflow-section__title {
    font-size: var(--s26-size-h2);
    line-height: 1.05;
  }

  .workflow-section__prompt {
    margin-top: 0.5rem;
  }

  .workflow-section__media {
    --media-asset-radius: var(--s26-radius);
  }

  .workflow-section__media :global(.workflow-section__image) {
    inline-size: min(100%, 31.25rem);
    margin-inline: auto 0;
    border-radius: var(--s26-radius);
  }

  .capability-detail {
    background: #ffffff;
  }

  .capability-detail__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 1fr);
    align-items: center;
    gap: 3rem;
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .capability-detail--creative .capability-detail__inner {
    padding-block-end: var(--s26-section);
  }

  .capability-detail__inner--reverse {
    grid-template-columns: minmax(20rem, 1fr) minmax(0, 1fr);
  }

  .capability-detail__inner--text-only,
  .capability-detail__inner--reverse.capability-detail__inner--text-only {
    grid-template-columns: minmax(0, 54rem);
  }

  .capability-detail__copy {
    display: grid;
    gap: 0.875rem;
    max-width: 62ch;
  }

  .capability-detail__title {
    font-size: var(--s26-size-h2);
    line-height: 1.05;
  }

  .capability-detail__button {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .capability-detail__media {
    --media-asset-radius: var(--s26-radius);
    --media-asset-max-block-size: 32rem;
    --media-asset-fit: cover;
  }

  .capability-detail__media :global(.capability-detail__image) {
    inline-size: 100%;
    height: auto;
    max-block-size: 32rem;
    object-fit: cover;
    border-radius: var(--s26-radius);
  }

  @media (max-width: 1024px) {
    .capabilities-hero__inner,
    .outcomes-section__inner,
    .workflow-section__inner,
    .capability-detail__inner,
    .capability-detail__inner--reverse {
      display: block;
    }

    .capabilities-hero__media,
    .outcomes-section__media,
    .capability-detail__media {
      display: none;
    }

    .outcomes-section__heading {
      margin-bottom: 2rem;
    }

    .outcomes-section__copy {
      margin-inline: auto;
      text-align: center;
    }

    .workflow-section__inner {
      display: flex;
      flex-direction: column-reverse;
    }

    .workflow-section__media {
      max-width: 28rem;
      margin: 0 auto 2.5rem;
    }

    .capability-detail__inner {
      padding-block: 2.5rem;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaAsset from '../../components/MediaAsset.astro';
import { capabilitiesPageQuery, sanityClient } from '../../lib/sanity';
import { defaultCapabilitiesPageData, mergeCapabilitiesPageData } from '../../lib/fixedPageData';
import { imageProps, richHtml } from '../../lib/fixedPageRender';

/*
  Flow: hero → the capabilities (intro, then one split per practice) → how
  the practices work together, ending on a next step. Every heading is
  left-aligned, as on the homepage.
*/

const sanityPage = await sanityClient.fetch(capabilitiesPageQuery).catch(() => null);
const page = mergeCapabilitiesPageData(sanityPage);
const title = page.seoTitle || defaultCapabilitiesPageData.seoTitle;
const description = page.seoDescription || defaultCapabilitiesPageData.seoDescription;
const canonical = page.canonicalUrl || defaultCapabilitiesPageData.canonicalUrl;
const robots = page.robots || defaultCapabilitiesPageData.robots;

const heroMedia = imageProps(page.hero, 'eager');
const workflowMedia = imageProps(page.workflow);
const heroImageAlt = page.hero.imageAlt || '';
const workflowImageAlt = page.workflow.imageAlt || '';
const workflowCta = page.workflow.cta?.label && page.workflow.cta?.href ? page.workflow.cta : null;

// Anchors other pages may already point at keep their ids; new entries get one from their stable id.
const detailAnchors: Record<string, string> = {
  data: 'capabilities-data-reporting-analytics',
  paid: 'capabilities-paid-media',
  creative: 'capabilities-performance-creative',
  ai: 'capabilities-ai',
};
const details = page.details
  .filter((detail) => detail.heading)
  .map((detail, index) => {
    const key = detail.id || String(index);
    return {
      ...detail,
      key,
      anchor: detailAnchors[key] || `capabilities-${key}`,
      media: imageProps(detail),
      alt: detail.imageAlt || '',
      reverse: index % 2 === 1,
    };
  });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: canonical,
  description,
  publisher: {
    '@type': 'Organization',
    name: 'Found Search Marketing',
    url: 'https://foundsm.com',
    logo: 'https://foundsm.com/images/logo.svg'
  }
};
---

<BaseLayout title={title} description={description} canonical={canonical} robots={robots} schema={schema} bodyClass="site-2026">
  <div class="capabilities-page">
    <section class="capabilities-hero" aria-labelledby="capabilities-hero-title">
      <div class:list={['capabilities-hero__inner', { 'capabilities-hero__inner--text-only': !heroMedia }]}>
        <div class="capabilities-hero__copy">
          <h1 id="capabilities-hero-title" class="capabilities-hero__title">{page.hero.heading}</h1>
          <div class="capabilities-hero__text" set:html={richHtml(page.hero.body)} />
        </div>

        {heroMedia && (
          <div class="capabilities-hero__media" aria-hidden={heroImageAlt ? undefined : 'true'}>
            <MediaAsset
              class="capabilities-hero__image"
              src={heroMedia.src}
              width="900"
              height="600"
              alt={heroImageAlt}
              loading="eager"
            />
          </div>
        )}
      </div>
    </section>

    <section class="practices-section" aria-labelledby="practices-title">
      <div class="practices-section__head">
        {page.outcomes.eyebrow && <p class="eyebrow-2026">{page.outcomes.eyebrow}</p>}
        <h2 id="practices-title" class="practices-section__title">{page.outcomes.heading}</h2>
        <div class="practices-section__intro" set:html={richHtml(page.outcomes.body)} />
      </div>

      {details.map((detail) => (
        <article class:list={['capability-detail', `capability-detail--${detail.key}`]} id={detail.anchor} aria-labelledby={`${detail.anchor}-title`}>
          <div class:list={['capability-detail__inner', { 'capability-detail__inner--reverse': detail.reverse, 'capability-detail__inner--text-only': !detail.media }]}>
            {detail.media && detail.reverse && (
              <div class="capability-detail__media" aria-hidden={detail.alt ? undefined : 'true'}>
                <MediaAsset class="capability-detail__image" src={detail.media.src} width="900" height="675" alt={detail.alt} loading="lazy" />
              </div>
            )}

            <div class="capability-detail__copy">
              <h3 id={`${detail.anchor}-title`} class="capability-detail__title">{detail.heading}</h3>
              <div class="capability-detail__text" set:html={richHtml(detail.body)} />
              {detail.cta?.label && detail.cta?.href && (
                <a class="btn btn--primary capability-detail__button" href={detail.cta.href}>{detail.cta.label}</a>
              )}
            </div>

            {detail.media && !detail.reverse && (
              <div class="capability-detail__media" aria-hidden={detail.alt ? undefined : 'true'}>
                <MediaAsset class="capability-detail__image" src={detail.media.src} width="900" height="675" alt={detail.alt} loading="lazy" />
              </div>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="workflow-section" aria-labelledby="workflow-title">
      <div class:list={['workflow-section__inner', { 'workflow-section__inner--text-only': !workflowMedia }]}>
        <div class="workflow-section__copy">
          <h2 id="workflow-title" class="workflow-section__title">{page.workflow.heading}</h2>
          <div class="workflow-section__text" set:html={richHtml(page.workflow.body)} />
          {workflowCta && <a class="btn btn--primary workflow-section__button" href={workflowCta.href}>{workflowCta.label}</a>}
        </div>

        {workflowMedia && (
          <div class="workflow-section__media">
            <MediaAsset
              class="workflow-section__image"
              src={workflowMedia.src}
              width="500"
              height="500"
              alt={workflowImageAlt}
              loading="lazy"
            />
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Capabilities page on the 2026 type system: tokens come from site-2026.css. */
  .capabilities-page {
    color: var(--s26-ink);
    background: #ffffff;
    font-family: var(--font-body);
    overflow: hidden;
  }

  .capabilities-page :is(h1, h2, h3) {
    margin: 0;
    color: var(--s26-ink);
  }

  .capabilities-hero__inner,
  .practices-section__head,
  .capability-detail__inner,
  .workflow-section__inner {
    inline-size: var(--s26-shell);
    margin-inline: auto;
  }

  /* ---------------------------------------------------------------- hero */

  .capabilities-hero {
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(3rem, 6vw, 4rem);
  }

  .capabilities-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: start;
    gap: 2.5rem 3rem;
  }

  .capabilities-hero__inner--text-only {
    grid-template-columns: minmax(0, 46rem);
  }

  .capabilities-hero__copy {
    display: grid;
    gap: 1.5rem;
  }

  .capabilities-hero__title {
    font-size: var(--s26-size-h1);
    line-height: 0.94;
  }

  .capabilities-hero__text {
    max-width: 36.25rem;
    color: var(--s26-muted);
    font-size: var(--s26-text-lead);
    line-height: var(--s26-lh-body);
  }

  .capabilities-hero__media {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    max-block-size: 24rem;
    border-radius: var(--s26-radius);
    --media-asset-radius: var(--s26-radius);
    --media-asset-fit: cover;
  }

  .capabilities-hero__media :global(.capabilities-hero__image) {
    inline-size: 100%;
    block-size: 100%;
    border-radius: var(--s26-radius);
    object-fit: cover;
  }

  /* ------------------------------------------------------------ practices */

  .practices-section {
    padding-block: var(--s26-section);
    border-block-start: 1px solid var(--s26-line);
  }

  .practices-section__head {
    display: grid;
    gap: 0.875rem;
    padding-block-end: clamp(0.5rem, 2vw, 1.5rem);
  }

  .practices-section__head > * {
    max-width: 45rem;
  }

  .practices-section__title {
    font-size: var(--s26-size-h2);
    line-height: 1.05;
  }

  .practices-section__intro,
  .capability-detail__text,
  .workflow-section__text {
    color: var(--s26-muted);
    font-size: var(--s26-text-body);
    line-height: var(--s26-lh-body);
  }

  .practices-section__intro {
    max-width: 62ch;
  }

  .capabilities-hero__text :global(p),
  .practices-section__intro :global(p),
  .capability-detail__text :global(p),
  .workflow-section__text :global(p) {
    margin: 0;
  }

  .capabilities-hero__text :global(p + p),
  .practices-section__intro :global(p + p),
  .capability-detail__text :global(p + p),
  .workflow-section__text :global(p + p) {
    margin-top: 1rem;
  }

  /* Images: one aspect per slot and a hard height cap, so copy sets the
     section height rather than the picture. */
  .capability-detail__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 42%);
    align-items: center;
    gap: 3rem;
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .capability-detail__inner--reverse {
    grid-template-columns: minmax(18rem, 42%) minmax(0, 1fr);
  }

  .capability-detail__inner--text-only,
  .capability-detail__inner--reverse.capability-detail__inner--text-only {
    grid-template-columns: minmax(0, 54rem);
  }

  .capability-detail:last-child .capability-detail__inner {
    padding-block-end: 0;
  }

  .capability-detail__copy {
    display: grid;
    gap: 0.875rem;
    max-width: 62ch;
  }

  /* h3 in the outline, h2 on the scale: each practice reads as a peer section. */
  .capability-detail__title {
    font-size: var(--s26-size-h2);
    line-height: 1.05;
  }

  .capability-detail__button {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .capability-detail__media {
    --media-asset-radius: var(--s26-radius);
    --media-asset-fit: cover;
  }

  .capability-detail__media :global(.capability-detail__image) {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    max-block-size: 22rem;
    object-fit: cover;
    border-radius: var(--s26-radius);
  }

  /* ------------------------------------------------------------- workflow */

  .workflow-section {
    padding-block: var(--s26-section);
    background: var(--s26-paper);
  }

  .workflow-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 34%);
    align-items: center;
    gap: 3rem;
  }

  .workflow-section__inner--text-only {
    grid-template-columns: minmax(0, 54rem);
  }

  .workflow-section__copy {
    display: grid;
    gap: 0.875rem;
    max-width: 62ch;
  }

  .workflow-section__title {
    font-size: var(--s26-size-h2);
    line-height: 1.05;
  }

  .workflow-section__button {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .workflow-section__media {
    --media-asset-radius: var(--s26-radius);
  }

  .workflow-section__media :global(.workflow-section__image) {
    inline-size: min(100%, 22rem);
    margin-inline: auto 0;
    border-radius: var(--s26-radius);
  }

  @media (max-width: 1024px) {
    .capabilities-hero__inner,
    .capability-detail__inner,
    .capability-detail__inner--reverse,
    .workflow-section__inner {
      display: block;
    }

    .capabilities-hero__media,
    .capability-detail__media {
      display: none;
    }

    .capability-detail__inner {
      padding-block: 2rem;
    }

    .workflow-section__media {
      max-width: 18rem;
      margin-block-start: 2.5rem;
    }

    .workflow-section__media :global(.workflow-section__image) {
      margin-inline: 0;
    }
  }
</style>

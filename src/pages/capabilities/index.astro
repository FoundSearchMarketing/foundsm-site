---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaAsset from '../../components/MediaAsset.astro';
import StatementBand from '../../components/modern/StatementBand.astro';
import PracticeCard from '../../components/capabilities/PracticeCard.astro';
import HomeTalk from '../../components/home/HomeTalk.astro';
import { capabilitiesPageQuery, homePageQuery, sanityClient } from '../../lib/sanity';
import { defaultCapabilitiesPageData, mergeCapabilitiesPageData } from '../../lib/fixedPageData';
import { imageProps, richHtml } from '../../lib/fixedPageRender';
import { aiSection, outcomeIntroBlocks, outcomesHeading, practiceCards } from '../../lib/capabilitiesHub';
import { mergeHomePageData } from '../../lib/homePageData';
import { mergeHomeV2Content } from '../../lib/homeV2Data';
import '../../styles/homepage-v2.css';
import '../../styles/capabilities-hub.css';

/*
  Hub: hero, no-silos band, outcomes header + 2x2 practice cards, AI section,
  and the homepage contact form. The homepage stats band stays on the homepage.
  The long Outcomes intro paragraph stays in the data and is not rendered here.
*/

const [sanityPage, homeDoc] = await Promise.all([
  sanityClient.fetch(capabilitiesPageQuery).catch(() => null),
  sanityClient.fetch(homePageQuery).catch(() => null),
]);
const page = mergeCapabilitiesPageData(sanityPage);
const homePage = mergeHomePageData(homeDoc);
const homeContent = mergeHomeV2Content(homePage);

const title = page.seoTitle || defaultCapabilitiesPageData.seoTitle;
const description = page.seoDescription || defaultCapabilitiesPageData.seoDescription;
const canonical = page.canonicalUrl || defaultCapabilitiesPageData.canonicalUrl;
const robots = page.robots || defaultCapabilitiesPageData.robots;

const heroMedia = imageProps(page.hero, 'eager');
const heroImageAlt = page.hero.imageAlt || '';

const calloutLead = page.workflow.heading || '';
const calloutCta = page.workflow.cta?.label && page.workflow.cta?.href ? page.workflow.cta : null;
const calloutHtml = richHtml(page.workflow.body);

const outcomeIntro = richHtml(outcomeIntroBlocks(page));
const cards = practiceCards(page).map((card) => ({
  ...card,
  src: imageProps({ image: card.image, imageAlt: card.imageAlt })?.src || '',
  bodyHtml: richHtml(card.body),
}));
const ai = aiSection(page);
const aiMedia = imageProps({ image: ai.image, imageAlt: ai.imageAlt });
const talk = {
  ...homeContent.talk,
  eyebrow: 'Talk with us',
  heading: 'Start where it matters most.',
  intro:
    "Tell us where the pressure is: paid media that has stalled, data that won't connect, reporting nobody trusts, or creative that isn't converting. You'll talk with the people who run that work, and we'll show you how it connects to the rest of your system.",
  fields: {
    ...homeContent.talk.fields,
    notes: 'What should we look at first?',
  },
  button: 'Start the conversation',
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: canonical,
  description,
  publisher: {
    '@type': 'Organization',
    name: 'Found Search Marketing',
    url: 'https://foundsm.com',
    logo: 'https://foundsm.com/images/logo.svg'
  }
};
---

<BaseLayout title={title} description={description} canonical={canonical} robots={robots} schema={schema} bodyClass="site-2026">
  <div class="capabilities-page">
    <section class="capabilities-hero" aria-labelledby="capabilities-hero-title">
      <div class:list={['capabilities-hero__inner', { 'capabilities-hero__inner--text-only': !heroMedia }]}>
        <div class="capabilities-hero__copy">
          <h1 id="capabilities-hero-title" class="capabilities-hero__title">{page.hero.heading}</h1>
          <div class="capabilities-hero__text" set:html={richHtml(page.hero.body)} />
        </div>

        {heroMedia && (
          <div class="capabilities-hero__media" aria-hidden={heroImageAlt ? undefined : 'true'}>
            <MediaAsset
              class="capabilities-hero__image"
              src={heroMedia.src}
              width="900"
              height="600"
              alt={heroImageAlt}
              loading="eager"
            />
          </div>
        )}
      </div>
    </section>

    {calloutLead && (
      <div class="capabilities-callout">
        <StatementBand
          lead={calloutLead}
          body=""
          bodyHtml={calloutHtml}
          theme="dark"
          pattern
          cta={calloutCta?.label && calloutCta?.href ? { label: calloutCta.label, href: calloutCta.href } : undefined}
        />
      </div>
    )}
  </div>

  <div class="home2 capabilities-hub">
    <section class="home2-section capabilities-outcomes" id="practices" aria-labelledby="capabilities-outcomes-title">
      <div class="home2-shell capabilities-outcomes__inner">
        <div class="home2-head">
          {page.outcomes.eyebrow && <p class="home2-eyebrow">{page.outcomes.eyebrow}</p>}
          <h2 id="capabilities-outcomes-title">{outcomesHeading(page)}</h2>
          <div set:html={outcomeIntro} />
        </div>
        <div class="capabilities-hub__grid">
          {cards.map((card) => (
            <PracticeCard
              anchor={card.anchor}
              href={card.href}
              image={card.src}
              imageAlt={card.imageAlt}
              heading={card.heading}
              lead={card.lead}
              bodyHtml={card.bodyHtml}
              label={card.label}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="home2-section home2-section--dark capabilities-ai" id={ai.anchor} aria-labelledby="capabilities-ai-title">
      <div class="home2-shell capabilities-ai__inner">
        <div class="capabilities-ai__copy">
          <div class="home2-head">
            <p class="home2-eyebrow home2-eyebrow--light">{homeContent.ai.eyebrow}</p>
            <h2 id="capabilities-ai-title">{ai.heading}</h2>
          </div>
          <div class="capabilities-ai__text home2-body" set:html={richHtml(ai.body)} />
          {ai.label && ai.href && (
            <a class="btn btn--primary" href={ai.href}>{ai.label}</a>
          )}
        </div>
        {aiMedia && (
          <img
            class="capabilities-ai__image"
            src={aiMedia.src}
            alt={ai.imageAlt}
            width="850"
            height="887"
            loading="lazy"
          />
        )}
      </div>
    </section>

    <HomeTalk talk={talk} />
  </div>
</BaseLayout>

<style>
  .capabilities-page {
    color: var(--s26-ink);
    background: #ffffff;
    font-family: var(--font-body);
    overflow: hidden;
  }

  .capabilities-page :is(h1, h2, h3) {
    margin: 0;
    color: var(--s26-ink);
  }

  .capabilities-hero__inner {
    inline-size: var(--s26-shell);
    margin-inline: auto;
  }

  .capabilities-hero {
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(3rem, 6vw, 4rem);
  }

  .capabilities-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: start;
    gap: 2.5rem 3rem;
  }

  .capabilities-hero__inner--text-only {
    grid-template-columns: minmax(0, 46rem);
  }

  .capabilities-hero__copy {
    display: grid;
    gap: 1.5rem;
  }

  .capabilities-hero__title {
    font-size: var(--s26-size-h1);
    line-height: 0.94;
  }

  .capabilities-hero__text {
    max-width: 36.25rem;
    color: var(--s26-muted);
    font-size: var(--s26-text-lead);
    line-height: var(--s26-lh-body);
  }

  .capabilities-hero__media {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    max-block-size: 24rem;
    border-radius: var(--s26-radius);
    --media-asset-radius: var(--s26-radius);
    --media-asset-fit: cover;
  }

  .capabilities-hero__media :global(.capabilities-hero__image) {
    inline-size: 100%;
    block-size: 100%;
    border-radius: var(--s26-radius);
    object-fit: cover;
  }

  .capabilities-hero__text :global(p) {
    margin: 0;
  }

  .capabilities-hero__text :global(p + p) {
    margin-top: 1rem;
  }

  .capabilities-callout :global(.statement-band__inner) {
    inline-size: min(84.375rem, 100%);
  }

  @media (max-width: 1024px) {
    .capabilities-hero__inner {
      display: block;
    }

    .capabilities-hero__media {
      display: none;
    }
  }
</style>

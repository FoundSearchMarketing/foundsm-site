---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageV2 from '../components/home/HomepageV2.astro';
import { homePageQuery, homeSignalsQuery, sanityClient } from '../lib/sanity';
import { mergeHomePageData } from '../lib/homePageData';
import type { HomeV2Signal } from '../lib/homeV2Data';

type SignalPost = { title?: string; slug?: string; publishedAt?: string };

const [homePageData, signalPosts] = await Promise.all([
  sanityClient.fetch(homePageQuery).catch(() => null),
  sanityClient.fetch<SignalPost[]>(homeSignalsQuery).catch(() => [] as SignalPost[]),
]);
const homePage = mergeHomePageData(homePageData);
const signalDate = (value?: string) => {
  const date = value ? new Date(value) : null;
  return date && !Number.isNaN(date.getTime())
    ? date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    : '';
};
const signals: HomeV2Signal[] = (signalPosts || [])
  .filter((post) => post.title && post.slug)
  .map((post) => ({
    label: ['Signal', signalDate(post.publishedAt)].filter(Boolean).join(' · '),
    title: post.title as string,
    href: `/insights/${post.slug}/`,
  }));

// The homepage sets its display type in Archivo; the rest of the site stays on Fraunces.
const homeFontHref =
  'https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,900&family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,900&family=Poppins:wght@300;400;500;600;700&display=swap';
const title = homePage.seoTitle || 'FoundSM | An Enterprise Paid Media Agency';
const description = homePage.seoDescription || 'Trusted by leading brands, FoundSM is an enterprise paid media agency delivering clarity, efficiency, and performance through advanced data-driven solutions.';
const canonical = homePage.canonicalUrl || 'https://foundsm.com/';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Found Search Marketing",
      "alternateName": "FoundSM",
      "url": "https://foundsm.com",
      "logo": "https://foundsm.com/images/logo.svg",
      "description": "An enterprise paid media agency that drives measurable growth.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "8475 Nightfall Lane, Suite 200",
        "addressLocality": "Fishers",
        "addressRegion": "IN",
        "postalCode": "46037",
        "addressCountry": "US"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+1-317-721-2229",
        "contactType": "sales",
        "email": "info@foundsm.com"
      },
      "sameAs": [
        "https://www.facebook.com/foundsm/",
        "https://www.instagram.com/found_sm/",
        "https://www.linkedin.com/company/found-search-marketing/",
        "https://x.com/FoundSM"
      ]
    },
    {
      "@type": "WebPage",
      "name": title,
      "url": canonical,
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "Found Search Marketing"
      }
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={homePage.ogTitle}
  ogDescription={homePage.ogDescription}
  ogImage={homePage.ogImage}
  robots={homePage.robots}
  twitterCard={homePage.twitterCard}
  twitterTitle={homePage.twitterTitle}
  twitterDescription={homePage.twitterDescription}
  twitterImage={homePage.twitterImage}
  schema={schema}
  schemaJson={homePage.schemaJson}
  bodyClass="home-page"
  fontHref={homeFontHref}
>
  <HomepageV2 data={homePage} signals={signals} />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import InsightsHero from '../components/InsightsHero.astro';
import LatestPostsSection from '../components/LatestPostsSection.astro';
import InsightsArticlesTabs from '../components/InsightsArticlesTabs.astro';
import InsightsArticleCards from '../components/InsightsArticleCards.astro';
import InsightsPagination from '../components/InsightsPagination.astro';
import { getAllBlogCategories, getAllBlogPosts, toInsightsArticleCards, toLatestPostCards, type BlogPost } from '../lib/blogPosts';
import { defaultInsightsPageData, mergeInsightsPageData } from '../lib/insightsPageData';
import { insightsPageQuery, sanityClient, urlFor } from '../lib/sanity';

const [sanityPage, posts, categories] = await Promise.all([
  sanityClient.fetch(insightsPageQuery).catch(() => null),
  getAllBlogPosts(),
  getAllBlogCategories(),
]);
const page = mergeInsightsPageData(sanityPage);
const featuredPostCount = 2;
const curatedPosts = (page.featuredPostSlugs || [])
  .map((slug) => posts.find((post) => post.slug === slug))
  .filter((post): post is BlogPost => Boolean(post));
const latestPosts = toLatestPostCards(curatedPosts.length ? curatedPosts : posts, featuredPostCount);
const articleCards = toInsightsArticleCards(posts);
const articleTabs = [
  { label: 'All', filter: '__all', active: true },
  ...categories.map((category) => ({ label: category.label, filter: category.slug })),
];
const postsPerPage = 6;
const totalPages = Math.ceil(posts.length / postsPerPage);
const pageTitle = page.seoTitle || defaultInsightsPageData.seoTitle;
const pageDescription = page.seoDescription || defaultInsightsPageData.seoDescription;
const canonical = page.canonicalUrl || defaultInsightsPageData.canonicalUrl;
// The lightbulb photo carries ~50px of pure-black padding above and below
// the bulb (source is 434x609); the rect crop trims it so the visible bulb
// top-aligns with the headline. Applied only to this exact asset.
const LIGHTBULB_ASSET_REF = 'image-7ba62a3b1abe0c305a95bd44a6688b2d326ad885-434x609-webp';
const heroImageRef = (page.hero.image as { asset?: { _ref?: string } } | undefined)?.asset?._ref;
const heroImage = (() => {
  if (!page.hero.image) return undefined;

  try {
    if (heroImageRef === LIGHTBULB_ASSET_REF) {
      return urlFor(page.hero.image).rect(0, 50, 434, 510).width(600).auto('format').url();
    }
    return urlFor(page.hero.image).width(868).height(1218).fit('crop').auto('format').url();
  } catch {
    return undefined;
  }
})();
const heroVideo = typeof page.hero.videoUrl === 'string' ? page.hero.videoUrl.trim() : '';
const heroMedia = heroVideo || heroImage;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "Found Search Marketing",
      "url": "https://foundsm.com",
      "logo": "https://foundsm.com/images/logo.svg"
    },
    {
      "@type": "WebPage",
      "name": pageTitle,
      "url": canonical,
      "description": pageDescription,
      "publisher": {
        "@type": "Organization",
        "name": "Found Search Marketing"
      }
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  robots={page.robots}
  schema={schema}
>

    <!-- ============================================
         HERO SECTION
         ============================================ -->
    <InsightsHero headline={page.hero.headline} body={page.hero.body} imageSrc={heroMedia} imageAlt={page.hero.imageAlt} />

    <LatestPostsSection posts={latestPosts} />

    <InsightsArticlesTabs tabs={articleTabs} />

    <InsightsArticleCards articles={articleCards} postsPerPage={postsPerPage}>
      <InsightsPagination slot="pagination" pageSize={postsPerPage} totalPages={totalPages} />
    </InsightsArticleCards>

</BaseLayout>
